---
import { clientsData } from '../../data/clients/clientsData';
---

<section class="sectors-section">
  <div class="sectors-container">
    <div class="sectors-header">
      <span class="sectors-subtitle">{clientsData.sectors.subtitle}</span>
      <h2 class="sectors-title">{clientsData.sectors.title}</h2>
    </div>

    <div class="sectors-grid">
      {clientsData.sectors.items.map((item) => (
        <div class={`sector-card ${item.span === 2 ? 'col-span-2' : ''}`}>
          <div>
            <div class="icon-wrapper" style={`background-color: ${item.bgColor}; color: ${item.color};`}>
              <span class="material-symbols-outlined">{item.icon}</span>
            </div>
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .sectors-section {
    padding: 80px 24px;
    background-color: #ffffff; /* surface-container-lowest */
  }

  .sectors-container {
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
  }

  .sectors-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .sectors-subtitle {
    display: block;
    color: #9d4300; /* secondary */
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 8px;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
  }

  .sectors-title {
    color: #0b1c30; /* on-background */
    font-size: 32px;
    line-height: 40px;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-family: var(--font-heading, 'Manrope', sans-serif);
  }

  .sectors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    grid-auto-rows: minmax(250px, auto);
  }

  @media (min-width: 768px) {
    .sectors-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .sector-card {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(0, 0, 0, 0.03);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.04);
    border-radius: 16px; /* modern radius */
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, background-color 0.3s ease;
  }

  .sector-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08); /* deeper shadow on hover */
    border-color: #cbd5e1; /* Light grey border */
    background-color: rgba(248, 250, 252, 0.95); /* Lightly shifted background color */
  }

  @media (min-width: 768px) {
    .col-span-2 {
      grid-column: span 2 / span 2;
    }
  }

  .icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  /* Playful elastic icon pop on card hover */
  .sector-card:hover .icon-wrapper {
    transform: scale(1.15) rotate(-4deg);
  }

  .icon-wrapper .material-symbols-outlined {
    font-variation-settings: 'FILL' 1;
  }

  .card-title {
    color: #0b1c30; /* on-surface */
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    margin-bottom: 12px;
    font-family: var(--font-heading, 'Manrope', sans-serif);
    transition: color 0.3s ease;
  }
  
  .sector-card:hover .card-title {
    color: #9d4300; /* Subtle shift to brand orange */
  }

  .card-desc {
    color: #45464d; /* on-surface-variant */
    font-size: 16px;
    line-height: 24px;
    font-weight: 400;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    opacity: 0.85;
  }
</style>
