---
export interface BenefitItem {
  title: string;
  desc: string;
  icon: string;
}

export interface Props {
  benefitsTitle: string;
  benefitsSubtitle: string;
  benefits: BenefitItem[];
}

const { benefitsTitle, benefitsSubtitle, benefits } = Astro.props;
---

<section class="city-benefits">
  <div class="benefits-container">
    <div class="benefits-header">
      <h2 class="benefits-title">{benefitsTitle}</h2>
      <p class="benefits-subtitle">{benefitsSubtitle}</p>
    </div>

    <div class="benefits-grid">
      {benefits.map((benefit) => (
        <div class="benefit-card">
          <div class="icon-wrapper">
            <span class="material-symbols-outlined">{benefit.icon}</span>
          </div>
          <h3 class="card-title">{benefit.title}</h3>
          <p class="card-desc">{benefit.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .city-benefits {
    background-color: #fafafa;
    padding: 80px 24px;
  }

  .benefits-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .benefits-header {
    text-align: center;
    margin-bottom: 60px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
  }

  .benefits-title {
    font-family: var(--font-heading, 'Hanken Grotesk', sans-serif);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 16px;
  }

  .benefits-subtitle {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 18px;
    color: #666666;
    line-height: 1.6;
  }

  .benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }

  .benefit-card {
    background-color: white;
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    border: 1px solid #f0f0f0;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* Slightly moving animation / interaction */
  .benefit-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 30px rgba(255, 171, 64, 0.1);
    border-color: #ffe082;
  }

  .icon-wrapper {
    background-color: #fff8e1;
    color: #ffab40;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition: all 0.3s ease;
  }

  .benefit-card:hover .icon-wrapper {
    background-color: #ffab40;
    color: white;
    transform: scale(1.1) rotate(5deg);
  }

  .icon-wrapper span {
    font-size: 28px;
  }

  .card-title {
    font-family: var(--font-heading, 'Hanken Grotesk', sans-serif);
    font-size: 20px;
    font-weight: 700;
    color: #333333;
    margin-bottom: 12px;
  }

  .card-desc {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 15px;
    color: #666666;
    line-height: 1.6;
  }
</style>
