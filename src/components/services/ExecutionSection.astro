---
import { executionSectionData } from '../../data/services/executionServices';
---

<section class="execution-section">
  <div class="execution-container">
    
    <!-- Section Header -->
    <div class="section-header">
      <span class="stage-badge">{executionSectionData.stageBadge}</span>
      <h2 class="section-title">{executionSectionData.title}</h2>
      <p class="section-subtitle">{executionSectionData.subtitle}</p>
    </div>

    <!-- Services Grid -->
    <div class="services-list">
      {executionSectionData.services.map((service, index) => {
        const isReversed = index % 2 !== 0;
        return (
          <div class={`service-row ${isReversed ? 'reversed' : ''}`}>
            
            <!-- Text Content Card -->
            <div class="service-card">
              <span class="service-number">{service.number}</span>
              <h3 class="service-title">{service.title}</h3>
              <p class="service-description">{service.description}</p>
              
              {service.subtitle && <p class="footer-label">{service.subtitle}</p>}
              <ul class="points-list">
                {service.points.map((point) => (
                  <li>
                    <span class="material-symbols-outlined check-icon">check_circle</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Image Card -->
            <div class="image-card">
              <img 
                src={service.imageUrl} 
                alt={service.imageAlt}
                loading="lazy"
                class="service-img"
              />
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  .execution-section {
    background-color: var(--color-bg, #f4f6f9);
    padding: 90px 24px;
    width: 100%;
  }

  .execution-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
  }

  /* Section Header */
  .section-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .stage-badge {
    display: inline-block;
    padding: 6px 16px;
    background-color: rgba(230, 92, 0, 0.1);
    color: var(--color-orange, #e65c00);
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 13px;
    font-weight: 700;
    border-radius: 20px;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .section-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 36px;
    font-weight: 800;
    color: var(--color-text-dark, #0d1424);
    margin-bottom: 8px;
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 42px;
    }
  }

  .section-subtitle {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 16px;
    color: #5c6479;
  }

  /* Services Grid & Alternate Row Mechanics */
  .services-list {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .service-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .service-row {
      grid-template-columns: 1fr 1fr;
    }

    .service-row.reversed .service-card {
      order: 2;
    }

    .service-row.reversed .image-card {
      order: 1;
    }
  }

  /* Content Card Styling */
  .service-card {
    background-color: #ffffff;
    border-radius: 16px;
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    box-shadow: 0px 4px 20px rgba(13, 20, 36, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .service-number {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 32px;
    font-weight: 800;
    color: #cbd5e1;
    margin-bottom: 12px;
    display: block;
  }

  .service-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 24px;
    font-weight: 700;
    color: var(--color-text-dark, #0d1424);
    margin-bottom: 12px;
  }

  .service-description {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 15px;
    line-height: 24px;
    color: #475569;
    margin-bottom: 24px;
  }

  .footer-label {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 15px;
    font-weight: 700;
    color: var(--color-text-dark, #0d1424);
    margin-bottom: 12px;
  }

  .points-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .points-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 14px;
    line-height: 20px;
    color: #334155;
  }

  .check-icon {
    font-size: 20px !important;
    color: var(--color-orange, #e65c00);
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Image Card */
  .image-card {
    min-height: 280px;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    background-color: #e2e8f0;
  }

  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-card:hover .service-img {
    transform: scale(1.03);
  }
</style>