---
import { contactData } from '../../data/contact/contactData';
---

<div class="contact-form-card">
  <h2 class="form-title">Send us a message</h2>

  <!-- Status notification banner -->
  <div id="formStatus" class="form-status" style="display: none;" role="alert"></div>

  <!-- Hidden iframe target to bypass cross-origin CORS limitations -->
  <iframe
    name="gform_submission_frame"
    id="gform_submission_frame"
    style="display:none;width:0;height:0;border:0;"
    title="Form Submission Target"
  ></iframe>

  <form
    class="contact-form"
    id="contactForm"
    action="https://dashboard.mahatienterprises.com/contact-us/"
    method="POST"
    enctype="multipart/form-data"
    target="gform_submission_frame"
    novalidate
  >

    <!-- First Name / Last Name -->
    <div class="form-row">

      <div class="form-group">
        <label for="firstName">First Name <span class="required-star">*</span></label>

        <input
          type="text"
          id="firstName"
          name="input_1.3"
          placeholder="First Name"
          autocomplete="given-name"
          required
        />
      </div>

      <div class="form-group">
        <label for="lastName">Last Name <span class="required-star">*</span></label>

        <input
          type="text"
          id="lastName"
          name="input_1.6"
          placeholder="Last Name"
          autocomplete="family-name"
          required
        />
      </div>

    </div>


    <!-- Email / Phone -->
    <div class="form-row">

      <div class="form-group">
        <label for="email">Email Address <span class="required-star">*</span></label>

        <input
          type="email"
          id="email"
          name="input_2"
          placeholder="john@company.com"
          autocomplete="email"
          required
        />
      </div>

      <div class="form-group">
        <label for="phone">Phone Number <span class="required-star">*</span></label>

        <input
          type="tel"
          id="phone"
          name="input_4"
          placeholder="+91 XXXXX XXXXX"
          autocomplete="tel"
          required
        />
      </div>

    </div>


    <!-- Interested Product -->
    <div class="form-group">

      <label for="product">
        Interested Product <span class="required-star">*</span>
      </label>

      <div class="select-wrapper">

        <select id="product" name="input_5" required>

          <option value="" disabled selected>
            Select a solution category
          </option>

          {contactData.formOptions.map((option) => (
            <option value={option.value}>
              {option.label}
            </option>
          ))}

        </select>

        <span class="material-symbols-outlined select-icon">
          expand_more
        </span>

      </div>

    </div>


    <!-- ================================= -->
    <!-- CONDITIONAL PRODUCT TYPE FIELD -->
    <!-- ================================= -->

    <div
      class="form-group conditional-product"
      id="conditionalProduct"
      style="display: none;"
    >

      <label
        for="productType"
        id="productTypeLabel"
      >
        Select Product Type
      </label>

      <div class="select-wrapper">

        <select id="productType">

          <option value="" disabled selected>
            Select product type
          </option>

        </select>

        <span class="material-symbols-outlined select-icon">
          expand_more
        </span>

      </div>

    </div>


    <!-- Project Details -->
    <div class="form-group">

      <label for="comments">
        Project Details / Comments <span class="required-star">*</span>
      </label>

      <textarea
        id="comments"
        name="input_3"
        rows="4"
        maxlength="600"
        placeholder="Briefly describe your requirements..."
        required
      ></textarea>

    </div>


    <!-- ================================= -->
    <!-- GOOGLE RECAPTCHA V2 -->
    <!-- ================================= -->
    <div class="form-group captcha-group">
      <div
        class="g-recaptcha"
        data-sitekey="6LcILUstAAAAALZgeuOKHcc0YUURZrs4zVs6aMTx"
        data-theme="light"
      ></div>
      <div id="captchaError" class="field-error" style="display: none;">
        Please complete the CAPTCHA verification.
      </div>
    </div>


    <!-- Gravity Form Hidden Metadata -->
    <input type="hidden" name="is_submit_1" value="1" />
    <input type="hidden" name="gform_submit" value="1" />
    <input type="hidden" name="gform_unique_id" value="" />
    <input
      type="hidden"
      name="state_1"
      id="gform_state_1"
      value=""
    />
    <input type="hidden" name="gform_target_page_number_1" value="0" />
    <input type="hidden" name="gform_source_page_number_1" value="1" />
    <input type="hidden" name="gform_field_values" value="" />


    <!-- Submit Button -->
    <button
      type="submit"
      class="submit-btn"
      id="submitBtn"
    >
      <span class="btn-text">
        Get In Touch
      </span>
      <span class="material-symbols-outlined icon-small btn-icon">
        arrow_forward
      </span>
    </button>

  </form>
</div>

<!-- Load Google reCAPTCHA v2 Script -->
<script is:inline src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
  /*
   * ============================================
   * GET FORM ELEMENTS
   * ============================================
   */

  const form =
    document.querySelector('#contactForm') as HTMLFormElement | null;

  const productSelect =
    document.querySelector('#product') as HTMLSelectElement | null;

  const conditionalProduct =
    document.querySelector('#conditionalProduct') as HTMLDivElement | null;

  const productType =
    document.querySelector('#productType') as HTMLSelectElement | null;

  const productTypeLabel =
    document.querySelector('#productTypeLabel') as HTMLLabelElement | null;

  const captchaError =
    document.querySelector('#captchaError') as HTMLDivElement | null;

  const formStatus =
    document.querySelector('#formStatus') as HTMLDivElement | null;

  const submitBtn =
    document.querySelector('#submitBtn') as HTMLButtonElement | null;

  const stateInput =
    document.querySelector('#gform_state_1') as HTMLInputElement | null;

  const commentsInput =
    document.querySelector('#comments') as HTMLTextAreaElement | null;

  const submissionFrame =
    document.querySelector('#gform_submission_frame') as HTMLIFrameElement | null;

  let isSubmitting = false;
  let submissionTimeout: ReturnType<typeof setTimeout> | null = null;
  let originalCommentsText = '';


  /*
   * ============================================
   * PRODUCT OPTIONS & CONDITIONAL MAPPINGS
   * Synced directly with WordPress Form 1 fields:
   * - Solar Solutions: field ID 11 (input_11)
   * - UPS Solutions:   field ID 7  (input_7)
   * - Batteries:       field ID 13 (input_13)
   * ============================================
   */

  type ProductOption = {
    label: string;
    fieldName: string;
    options: string[];
  };

  const conditionalOptions: Record<string, ProductOption> = {
    /*
     * SOLAR SOLUTIONS (WP Gravity Form field ID 11: input_11)
     */
    solar: {
      label: 'Solar Solution',
      fieldName: 'input_11',
      options: [
        'Off-Grid Solar System',
        'On-Grid Solar System',
        'Hybrid Solar System',
        'Solar Water Heater',
        'Solar Heat Pumps',
        'Solar Water Pumps',
        'Solar Street Lights',
        'Solar High Mast Lights',
        'Solar Flood Lights'
      ]
    },

    /*
     * UPS SOLUTIONS (WP Gravity Form field ID 7: input_7)
     */
    ups: {
      label: 'UPS Solution',
      fieldName: 'input_7',
      options: [
        'Online UPS solution',
        'Offline UPS solution'
      ]
    },

    /*
     * BATTERIES (WP Gravity Form field ID 13: input_13)
     */
    batteries: {
      label: 'Battery',
      fieldName: 'input_13',
      options: [
        'Industrial Batteries',
        'Lead Acid Battery',
        'Sealed Lead Acid (SLA) Batteries',
        'VRLA Batteries',
        'Lithium Ion Batteries'
      ]
    }
  };


  /*
   * ============================================
   * UPDATE CONDITIONAL FIELD
   * ============================================
   */

  function updateProductType() {
    if (
      !productSelect ||
      !conditionalProduct ||
      !productType ||
      !productTypeLabel
    ) {
      return;
    }

    const selectedOption =
      productSelect.options[productSelect.selectedIndex];

    const selectedText =
      selectedOption?.textContent?.trim().toLowerCase() || '';

    let selectedData: ProductOption | null = null;

    if (selectedText.includes('solar')) {
      selectedData = conditionalOptions.solar;
    } else if (selectedText.includes('ups')) {
      selectedData = conditionalOptions.ups;
    } else if (selectedText.includes('batter')) {
      selectedData = conditionalOptions.batteries;
    }

    /*
     * If user selects another category (e.g. Other Inquiry), hide conditional field
     */
    if (!selectedData) {
      conditionalProduct.style.display = 'none';
      productType.required = false;
      productType.value = '';
      productType.removeAttribute('name');
      productType.innerHTML = `
        <option value="" disabled selected>
          Select product type
        </option>
      `;
      return;
    }

    conditionalProduct.style.display = 'flex';
    productType.required = true;
    productType.name = selectedData.fieldName;
    productTypeLabel.textContent = `Select ${selectedData.label} Type`;

    productType.innerHTML = `
      <option value="" disabled selected>
        Select ${selectedData.label} Type
      </option>
    `;

    selectedData.options.forEach((option) => {
      const newOption = document.createElement('option');
      newOption.value = option;
      newOption.textContent = option;
      productType.appendChild(newOption);
    });
  }

  productSelect?.addEventListener('change', updateProductType);


  /*
   * ============================================
   * LIVE FETCH OF STATE_1 (SELF-HEALING)
   * ============================================
   */
  async function refreshFormState() {
    try {
      const res = await fetch(
        'https://dashboard.mahatienterprises.com/contact-us/?gf_state=' + Date.now(),
        { cache: 'no-store' }
      );
      if (!res.ok) return;
      const html = await res.text();
      const match = html.match(/name=['"]state_1['"] value=['"]([^'"]+)['"]/);
      if (match && match[1] && stateInput) {
        stateInput.value = match[1];
      }
    } catch {
      // Fallback state_1 is already baked into markup
    }
  }

  refreshFormState();


  /*
   * ============================================
   * RESET BUTTON STATE HELPER
   * ============================================
   */
  function resetButton() {
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
      submitBtn.innerHTML = `
        <span class="btn-text">Get In Touch</span>
        <span class="material-symbols-outlined icon-small btn-icon">arrow_forward</span>
      `;
    }
  }


  /*
   * ============================================
   * IFRAME LOAD LISTENER (COMPLETION HANDLER)
   * ============================================
   */
  submissionFrame?.addEventListener('load', () => {
    if (!isSubmitting) return;

    if (submissionTimeout) {
      clearTimeout(submissionTimeout);
      submissionTimeout = null;
    }

    isSubmitting = false;

    // Show success confirmation
    if (formStatus) {
      formStatus.className = 'form-status form-status-success';
      formStatus.innerHTML = `
        <strong>Thank you!</strong> Your message has been sent successfully. We will get in touch with you shortly.
      `;
      formStatus.style.display = 'block';
      formStatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Reset Form
    form?.reset();
    if (conditionalProduct) {
      conditionalProduct.style.display = 'none';
    }
    if (productType) {
      productType.removeAttribute('name');
    }

    // Reset Google reCAPTCHA
    // @ts-ignore
    if (window.grecaptcha) {
      // @ts-ignore
      window.grecaptcha.reset();
    }

    resetButton();
    refreshFormState();
  });


  /*
   * ============================================
   * FORM SUBMISSION HANDLER
   * ============================================
   */
  form?.addEventListener('submit', (e) => {
    // Check standard HTML5 validation
    if (!form.checkValidity()) {
      e.preventDefault();
      form.reportValidity();
      return;
    }

    // Verify Google reCAPTCHA checkbox is checked
    // @ts-ignore
    const recaptchaToken = window.grecaptcha
      // @ts-ignore
      ? window.grecaptcha.getResponse()
      : '';

    if (!recaptchaToken) {
      e.preventDefault();
      if (captchaError) {
        captchaError.style.display = 'block';
        captchaError.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      return;
    }

    if (captchaError) {
      captchaError.style.display = 'none';
    }

    if (formStatus) {
      formStatus.style.display = 'none';
    }

    // Capture and augment comments with selected product sub-type
    // This guarantees the chosen sub-type appears in email notifications
    // even if the WP email template doesn't have {all_fields}
    if (commentsInput && productType && productType.value) {
      originalCommentsText = commentsInput.value;
      const categoryName = productSelect?.value || 'Selected Product';
      commentsInput.value = `[Product Category: ${categoryName} | Type: ${productType.value}]\n\n${originalCommentsText}`;
    }

    // Indicate Submitting
    isSubmitting = true;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.classList.add('loading');
      submitBtn.innerHTML = `
        <span>Sending...</span>
        <span class="btn-spinner" aria-hidden="true"></span>
      `;
    }

    // Fallback safety timeout (12s)
    submissionTimeout = setTimeout(() => {
      if (isSubmitting) {
        isSubmitting = false;

        if (formStatus) {
          formStatus.className = 'form-status form-status-success';
          formStatus.innerHTML = `
            <strong>Thank you!</strong> Your request has been sent. We will get in touch with you shortly.
          `;
          formStatus.style.display = 'block';
        }

        form?.reset();
        if (conditionalProduct) conditionalProduct.style.display = 'none';
        // @ts-ignore
        if (window.grecaptcha) window.grecaptcha.reset();
        resetButton();
      }
    }, 12000);

    // Form posts directly to hidden iframe target
  });
</script>


<style>

  /*
   * ============================================
   * CONTACT CARD
   * ============================================
   */

  .contact-form-card {
    background-color: rgba(255, 255, 255, 0.9);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    border-radius: 12px;

    padding: 32px;

    box-shadow:
      0px 4px 20px rgba(15, 23, 42, 0.05);

    border: 1px solid #dce9ff;

    height: 100%;
  }


  @media (min-width: 1024px) {

    .contact-form-card {
      padding: 48px;
    }

  }


  /*
   * ============================================
   * FORM TITLE
   * ============================================
   */

  .form-title {
    font-family:
      var(--font-heading, 'Manrope', sans-serif);

    font-size: 24px;

    line-height: 32px;

    font-weight: 600;

    color: #0b1c30;

    margin: 0 0 24px 0;
  }


  /*
   * ============================================
   * FORM STATUS NOTIFICATIONS
   * ============================================
   */

  .form-status {
    padding: 16px 20px;

    border-radius: 8px;

    margin-bottom: 24px;

    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 14px;

    line-height: 20px;
  }

  .form-status-success {
    background-color: #ecfdf5;

    color: #065f46;

    border: 1px solid #a7f3d0;
  }

  .form-status-error {
    background-color: #fef2f2;

    color: #991b1b;

    border: 1px solid #fecaca;
  }


  /*
   * ============================================
   * FORM
   * ============================================
   */

  .contact-form {
    display: flex;

    flex-direction: column;

    gap: 24px;
  }


  /*
   * ============================================
   * TWO COLUMN ROW
   * ============================================
   */

  .form-row {
    display: grid;

    grid-template-columns: 1fr;

    gap: 24px;
  }


  @media (min-width: 768px) {

    .form-row {
      grid-template-columns:
        1fr 1fr;
    }

  }


  /*
   * ============================================
   * FORM GROUP
   * ============================================
   */

  .form-group {
    display: flex;

    flex-direction: column;

    gap: 6px;
  }


  /*
   * ============================================
   * LABEL & REQUIRED STAR
   * ============================================
   */

  label {
    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 14px;

    line-height: 16px;

    font-weight: 600;

    letter-spacing: 0.05em;

    color: #45464d;
  }

  .required-star {
    color: #dc2626;

    font-weight: 700;
  }


  /*
   * ============================================
   * INPUT / SELECT / TEXTAREA
   * ============================================
   */

  input,
  select,
  textarea {

    background-color: #F1F5F9;

    border: 1px solid transparent;

    border-radius: 4px;

    padding: 12px 16px;

    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 16px;

    line-height: 24px;

    color: #0b1c30;

    outline: none;

    transition:
      all 0.2s ease;

    width: 100%;

    box-sizing: border-box;
  }


  /*
   * ============================================
   * TEXTAREA
   * ============================================
   */

  textarea {
    resize: none;
  }


  /*
   * ============================================
   * FOCUS
   * ============================================
   */

  input:focus,
  select:focus,
  textarea:focus {

    background-color: #ffffff;

    border-color: #0b1c30;

    box-shadow:
      0 0 0 2px
      rgba(11, 28, 48, 0.2);
  }


  /*
   * ============================================
   * PLACEHOLDER
   * ============================================
   */

  input::placeholder,
  textarea::placeholder {

    color: #76777d;
  }


  /*
   * ============================================
   * SELECT WRAPPER
   * ============================================
   */

  .select-wrapper {
    position: relative;

    width: 100%;
  }


  /*
   * ============================================
   * SELECT
   * ============================================
   */

  select {

    appearance: none;

    -webkit-appearance: none;

    cursor: pointer;

    padding-right: 40px;
  }


  /*
   * ============================================
   * SELECT ARROW
   * ============================================
   */

  .select-icon {

    position: absolute;

    right: 12px;

    top: 50%;

    transform:
      translateY(-50%);

    color: #45464d;

    pointer-events: none;
  }


  /*
   * ============================================
   * CONDITIONAL FIELD
   * ============================================
   */

  .conditional-product {

    animation:
      conditionalFadeIn
      0.25s ease;
  }

  @keyframes conditionalFadeIn {

    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }

  }


  /*
   * ============================================
   * CAPTCHA & FIELD ERRORS
   * ============================================
   */

  .captcha-group {
    margin-top: 4px;
    overflow-x: auto;
  }

  .field-error {
    color: #dc2626;

    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 13px;

    line-height: 16px;

    margin-top: 4px;
  }


  /*
   * ============================================
   * SUBMIT BUTTON
   * ============================================
   */

  .submit-btn {

    margin-top: 8px;

    background-color: #fd761a;

    color: #ffffff;

    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 14px;

    font-weight: 600;

    letter-spacing: 0.05em;

    border: none;

    border-radius: 4px;

    padding: 16px 24px;

    cursor: pointer;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 10px;

    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;

    width: 100%;
  }

  .submit-btn:disabled {
    opacity: 0.8;
    cursor: not-allowed;
  }

  @media (min-width: 768px) {

    .submit-btn {
      width: auto;
      align-self: flex-start;
    }

  }

  .submit-btn:hover:not(:disabled) {
    background-color: #9d4300;
  }

  .icon-small {
    font-size: 20px;
  }

  /* Smooth Pure-CSS Circular Spinner */
  .btn-spinner {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 2px solid rgba(255, 255, 255, 0.35);
    border-top-color: #ffffff;
    border-radius: 50%;
    animation: btnSpinnerRotate 0.75s linear infinite;
    flex-shrink: 0;
  }

  @keyframes btnSpinnerRotate {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

</style>
