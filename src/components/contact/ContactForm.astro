---
import { contactData } from '../../data/contact/contactData';
---

<div class="contact-form-card">
  <h2 class="form-title">Send us a message</h2>

  <!-- Status alert box -->
  <div id="formStatus" class="form-status" style="display: none;" role="alert"></div>

  <form class="contact-form" id="contactForm" novalidate>

    <!-- First Name / Last Name -->
    <div class="form-row">

      <div class="form-group">
        <label for="firstName">First Name <span class="required-star">*</span></label>

        <input
          type="text"
          id="firstName"
          name="input_1.3"
          placeholder="First Name"
          autocomplete="given-name"
          required
        />
      </div>

      <div class="form-group">
        <label for="lastName">Last Name <span class="required-star">*</span></label>

        <input
          type="text"
          id="lastName"
          name="input_1.6"
          placeholder="Last Name"
          autocomplete="family-name"
          required
        />
      </div>

    </div>


    <!-- Email / Phone -->
    <div class="form-row">

      <div class="form-group">
        <label for="email">Email Address <span class="required-star">*</span></label>

        <input
          type="email"
          id="email"
          name="input_2"
          placeholder="john@company.com"
          autocomplete="email"
          required
        />
      </div>

      <div class="form-group">
        <label for="phone">Phone Number <span class="required-star">*</span></label>

        <input
          type="tel"
          id="phone"
          name="input_4"
          placeholder="+91 XXXXX XXXXX"
          autocomplete="tel"
          required
        />
      </div>

    </div>


    <!-- Interested Product -->
    <div class="form-group">

      <label for="product">
        Interested Product <span class="required-star">*</span>
      </label>

      <div class="select-wrapper">

        <select id="product" name="input_5" required>

          <option value="" disabled selected>
            Select a solution category
          </option>

          {contactData.formOptions.map((option) => (
            <option value={option.value}>
              {option.label}
            </option>
          ))}

        </select>

        <span class="material-symbols-outlined select-icon">
          expand_more
        </span>

      </div>

    </div>


    <!-- ================================= -->
    <!-- CONDITIONAL PRODUCT TYPE FIELD -->
    <!-- ================================= -->

    <div
      class="form-group conditional-product"
      id="conditionalProduct"
      style="display: none;"
    >

      <label
        for="productType"
        id="productTypeLabel"
      >
        Select Product Type
      </label>

      <div class="select-wrapper">

        <select id="productType">

          <option value="" disabled selected>
            Select product type
          </option>

        </select>

        <span class="material-symbols-outlined select-icon">
          expand_more
        </span>

      </div>

    </div>


    <!-- Project Details -->
    <div class="form-group">

      <label for="comments">
        Project Details / Comments <span class="required-star">*</span>
      </label>

      <textarea
        id="comments"
        name="input_3"
        rows="4"
        maxlength="600"
        placeholder="Briefly describe your requirements..."
        required
      ></textarea>

    </div>


    <!-- ================================= -->
    <!-- GOOGLE RECAPTCHA V2 -->
    <!-- ================================= -->
    <div class="form-group captcha-group">
      <div
        class="g-recaptcha"
        data-sitekey="6LcILUstAAAAALZgeuOKHcc0YUURZrs4zVs6aMTx"
        data-theme="light"
      ></div>
      <div id="captchaError" class="field-error" style="display: none;">
        Please complete the CAPTCHA verification.
      </div>
    </div>


    <!-- Gravity Form Hidden Metadata -->
    <input type="hidden" name="is_submit_1" value="1" />
    <input type="hidden" name="gform_submit" value="1" />
    <input type="hidden" name="gform_unique_id" value="" />
    <input
      type="hidden"
      name="state_1"
      id="gform_state_1"
      value=""
    />
    <input type="hidden" name="gform_target_page_number_1" value="0" />
    <input type="hidden" name="gform_source_page_number_1" value="1" />
    <input type="hidden" name="gform_field_values" value="" />


    <!-- Submit Button -->
    <button
      type="submit"
      class="submit-btn"
      id="submitBtn"
    >
      <span class="btn-text">
        Get In Touch
      </span>
      <span class="material-symbols-outlined icon-small btn-icon">
        arrow_forward
      </span>
    </button>

  </form>
</div>

<!-- Load Google reCAPTCHA v2 Script -->
<script is:inline src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
  /*
   * ============================================
   * GET FORM ELEMENTS
   * ============================================
   */

  const form =
    document.querySelector('#contactForm') as HTMLFormElement | null;

  const productSelect =
    document.querySelector('#product') as HTMLSelectElement | null;

  const conditionalProduct =
    document.querySelector('#conditionalProduct') as HTMLDivElement | null;

  const productType =
    document.querySelector('#productType') as HTMLSelectElement | null;

  const productTypeLabel =
    document.querySelector('#productTypeLabel') as HTMLLabelElement | null;

  const captchaError =
    document.querySelector('#captchaError') as HTMLDivElement | null;

  const formStatus =
    document.querySelector('#formStatus') as HTMLDivElement | null;

  const submitBtn =
    document.querySelector('#submitBtn') as HTMLButtonElement | null;

  const stateInput =
    document.querySelector('#gform_state_1') as HTMLInputElement | null;


  /*
   * ============================================
   * PRODUCT OPTIONS & CONDITIONAL MAPPINGS
   * ============================================
   */

  type ProductOption = {
    label: string;
    fieldName: string;
    options: string[];
  };

  const conditionalOptions: Record<string, ProductOption> = {
    /*
     * SOLAR SOLUTIONS (WP field: input_6)
     */
    solar: {
      label: 'Solar Solution',
      fieldName: 'input_6',
      options: [
        'Off Grid Solar System',
        'On Grid Solar System',
        'Hybrid Solar System',
        'Water Heater',
        'Heat Pumps',
        'Water Pumps',
        'Street Lights',
        'High-Mast Lights',
        'Flood Lights'
      ]
    },

    /*
     * UPS SOLUTIONS (WP field: input_7)
     */
    ups: {
      label: 'UPS Solution',
      fieldName: 'input_7',
      options: [
        'Online UPS solution',
        'Offline UPS solution'
      ]
    },

    /*
     * BATTERIES (WP field: input_8)
     */
    batteries: {
      label: 'Battery',
      fieldName: 'input_8',
      options: [
        'Industrial Batteries',
        'Lead Acid Batteries',
        'Sealed Lead Acid (SLA) Batteries',
        'VRLA Batteries',
        'Lithium-Ion Batteries'
      ]
    }
  };


  /*
   * ============================================
   * UPDATE CONDITIONAL FIELD
   * ============================================
   */

  function updateProductType() {
    if (
      !productSelect ||
      !conditionalProduct ||
      !productType ||
      !productTypeLabel
    ) {
      return;
    }

    const selectedOption =
      productSelect.options[productSelect.selectedIndex];

    const selectedText =
      selectedOption?.textContent?.trim().toLowerCase() || '';

    let selectedData: ProductOption | null = null;

    if (selectedText.includes('solar')) {
      selectedData = conditionalOptions.solar;
    } else if (selectedText.includes('ups')) {
      selectedData = conditionalOptions.ups;
    } else if (selectedText.includes('batter')) {
      selectedData = conditionalOptions.batteries;
    }

    /*
     * If user selects another category (e.g. Other Inquiry), hide conditional field
     */
    if (!selectedData) {
      conditionalProduct.style.display = 'none';
      productType.required = false;
      productType.value = '';
      productType.removeAttribute('name');
      productType.innerHTML = `
        <option value="" disabled selected>
          Select product type
        </option>
      `;
      return;
    }

    conditionalProduct.style.display = 'flex';
    productType.required = true;
    productType.name = selectedData.fieldName;
    productTypeLabel.textContent = `Select ${selectedData.label} Type`;

    productType.innerHTML = `
      <option value="" disabled selected>
        Select ${selectedData.label} Type
      </option>
    `;

    selectedData.options.forEach((option) => {
      const newOption = document.createElement('option');
      newOption.value = option;
      newOption.textContent = option;
      productType.appendChild(newOption);
    });
  }

  productSelect?.addEventListener('change', updateProductType);


  /*
   * ============================================
   * LIVE FETCH OF STATE_1 (SELF-HEALING)
   * ============================================
   * Fetches latest Gravity Forms state token in the background
   * so the form stays resilient if WP choices are adjusted.
   */
  async function refreshFormState() {
    try {
      const res = await fetch(
        'https://dashboard.mahatienterprises.com/contact-us/?gf_state=' + Date.now(),
        { cache: 'no-store' }
      );
      if (!res.ok) return;
      const html = await res.text();
      const match = html.match(/name=['"]state_1['"] value=['"]([^'"]+)['"]/);
      if (match && match[1] && stateInput) {
        stateInput.value = match[1];
      }
    } catch {
      // Fallback state_1 already present in markup
    }
  }

  refreshFormState();


  /*
   * ============================================
   * FORM SUBMISSION HANDLER
   * ============================================
   */

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Verify Google reCAPTCHA
    // @ts-ignore
    const recaptchaToken = window.grecaptcha
      // @ts-ignore
      ? window.grecaptcha.getResponse()
      : '';

    if (!recaptchaToken) {
      if (captchaError) {
        captchaError.style.display = 'block';
        captchaError.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      return;
    }

    if (captchaError) {
      captchaError.style.display = 'none';
    }

    // Hide any previous status
    if (formStatus) {
      formStatus.style.display = 'none';
    }

    // Loading State
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.classList.add('loading');
      submitBtn.innerHTML = `
        <span>Sending...</span>
        <span class="material-symbols-outlined icon-small spinner">progress_activity</span>
      `;
    }

    try {
      const formData = new FormData(form);

      // Ensure recaptcha response is explicitly attached
      if (!formData.get('g-recaptcha-response')) {
        formData.append('g-recaptcha-response', recaptchaToken);
      }

      const response = await fetch('https://dashboard.mahatienterprises.com/contact-us/', {
        method: 'POST',
        body: formData
      });

      const responseHtml = await response.text();

      const isSuccess =
        response.ok &&
        (responseHtml.includes('gform_confirmation_message') ||
          responseHtml.includes('Thanks for contacting us') ||
          (!responseHtml.includes('gform_validation_error') && !responseHtml.includes('gfield_error')));

      if (isSuccess) {
        if (formStatus) {
          formStatus.className = 'form-status form-status-success';
          formStatus.innerHTML = `
            <strong>Thank you!</strong> Your message has been sent successfully. We will get in touch with you shortly.
          `;
          formStatus.style.display = 'block';
          formStatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        form.reset();
        if (conditionalProduct) {
          conditionalProduct.style.display = 'none';
        }
        if (productType) {
          productType.removeAttribute('name');
        }

        // Reset reCAPTCHA widget
        // @ts-ignore
        if (window.grecaptcha) {
          // @ts-ignore
          window.grecaptcha.reset();
        }

        // Re-fetch fresh state for subsequent submissions
        refreshFormState();
      } else {
        // Parse validation errors if returned from Gravity Forms
        let errorMsg =
          'There was an issue submitting your request. Please check the fields and try again.';

        try {
          const parser = new DOMParser();
          const doc = parser.parseFromString(responseHtml, 'text/html');
          const errorNodes = doc.querySelectorAll(
            '.gfield_validation_message, .validation_message, .gform_validation_errors'
          );
          if (errorNodes.length > 0) {
            const messages = Array.from(errorNodes)
              .map((node) => node.textContent?.trim())
              .filter(Boolean);
            if (messages.length > 0) {
              errorMsg = messages.join('. ');
            }
          }
        } catch {
          // Fallback to errorMsg
        }

        if (formStatus) {
          formStatus.className = 'form-status form-status-error';
          formStatus.innerHTML = `<strong>Error:</strong> ${errorMsg}`;
          formStatus.style.display = 'block';
          formStatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // Reset reCAPTCHA on failure so user can re-verify
        // @ts-ignore
        if (window.grecaptcha) {
          // @ts-ignore
          window.grecaptcha.reset();
        }
      }
    } catch {
      if (formStatus) {
        formStatus.className = 'form-status form-status-error';
        formStatus.innerHTML =
          '<strong>Network Error:</strong> Unable to connect to the server. Please check your connection or reach out to us directly.';
        formStatus.style.display = 'block';
        formStatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }

      // @ts-ignore
      if (window.grecaptcha) {
        // @ts-ignore
        window.grecaptcha.reset();
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.classList.remove('loading');
        submitBtn.innerHTML = `
          <span>Get In Touch</span>
          <span class="material-symbols-outlined icon-small">arrow_forward</span>
        `;
      }
    }
  });
</script>


<style>

  /*
   * ============================================
   * CONTACT CARD
   * ============================================
   */

  .contact-form-card {
    background-color: rgba(255, 255, 255, 0.9);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    border-radius: 12px;

    padding: 32px;

    box-shadow:
      0px 4px 20px rgba(15, 23, 42, 0.05);

    border: 1px solid #dce9ff;

    height: 100%;
  }


  @media (min-width: 1024px) {

    .contact-form-card {
      padding: 48px;
    }

  }


  /*
   * ============================================
   * FORM TITLE
   * ============================================
   */

  .form-title {
    font-family:
      var(--font-heading, 'Manrope', sans-serif);

    font-size: 24px;

    line-height: 32px;

    font-weight: 600;

    color: #0b1c30;

    margin: 0 0 24px 0;
  }


  /*
   * ============================================
   * FORM STATUS NOTIFICATIONS
   * ============================================
   */

  .form-status {
    padding: 16px 20px;

    border-radius: 8px;

    margin-bottom: 24px;

    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 14px;

    line-height: 20px;
  }

  .form-status-success {
    background-color: #ecfdf5;

    color: #065f46;

    border: 1px solid #a7f3d0;
  }

  .form-status-error {
    background-color: #fef2f2;

    color: #991b1b;

    border: 1px solid #fecaca;
  }


  /*
   * ============================================
   * FORM
   * ============================================
   */

  .contact-form {
    display: flex;

    flex-direction: column;

    gap: 24px;
  }


  /*
   * ============================================
   * TWO COLUMN ROW
   * ============================================
   */

  .form-row {
    display: grid;

    grid-template-columns: 1fr;

    gap: 24px;
  }


  @media (min-width: 768px) {

    .form-row {
      grid-template-columns:
        1fr 1fr;
    }

  }


  /*
   * ============================================
   * FORM GROUP
   * ============================================
   */

  .form-group {
    display: flex;

    flex-direction: column;

    gap: 6px;
  }


  /*
   * ============================================
   * LABEL & REQUIRED STAR
   * ============================================
   */

  label {
    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 14px;

    line-height: 16px;

    font-weight: 600;

    letter-spacing: 0.05em;

    color: #45464d;
  }

  .required-star {
    color: #dc2626;

    font-weight: 700;
  }


  /*
   * ============================================
   * INPUT / SELECT / TEXTAREA
   * ============================================
   */

  input,
  select,
  textarea {

    background-color: #F1F5F9;

    border: 1px solid transparent;

    border-radius: 4px;

    padding: 12px 16px;

    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 16px;

    line-height: 24px;

    color: #0b1c30;

    outline: none;

    transition:
      all 0.2s ease;

    width: 100%;

    box-sizing: border-box;
  }


  /*
   * ============================================
   * TEXTAREA
   * ============================================
   */

  textarea {
    resize: none;
  }


  /*
   * ============================================
   * FOCUS
   * ============================================
   */

  input:focus,
  select:focus,
  textarea:focus {

    background-color: #ffffff;

    border-color: #0b1c30;

    box-shadow:
      0 0 0 2px
      rgba(11, 28, 48, 0.2);
  }


  /*
   * ============================================
   * PLACEHOLDER
   * ============================================
   */

  input::placeholder,
  textarea::placeholder {

    color: #76777d;
  }


  /*
   * ============================================
   * SELECT WRAPPER
   * ============================================
   */

  .select-wrapper {
    position: relative;

    width: 100%;
  }


  /*
   * ============================================
   * SELECT
   * ============================================
   */

  select {

    appearance: none;

    -webkit-appearance: none;

    cursor: pointer;

    padding-right: 40px;
  }


  /*
   * ============================================
   * SELECT ARROW
   * ============================================
   */

  .select-icon {

    position: absolute;

    right: 12px;

    top: 50%;

    transform:
      translateY(-50%);

    color: #45464d;

    pointer-events: none;
  }


  /*
   * ============================================
   * CONDITIONAL FIELD
   * ============================================
   */

  .conditional-product {

    animation:
      conditionalFadeIn
      0.25s ease;
  }

  @keyframes conditionalFadeIn {

    from {
      opacity: 0;
      transform: translateY(-8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }

  }


  /*
   * ============================================
   * CAPTCHA & FIELD ERRORS
   * ============================================
   */

  .captcha-group {
    margin-top: 4px;
    overflow-x: auto;
  }

  .field-error {
    color: #dc2626;

    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 13px;

    line-height: 16px;

    margin-top: 4px;
  }


  /*
   * ============================================
   * SUBMIT BUTTON
   * ============================================
   */

  .submit-btn {

    margin-top: 8px;

    background-color: #fd761a;

    color: #ffffff;

    font-family:
      var(--font-body, 'Hanken Grotesk', sans-serif);

    font-size: 14px;

    font-weight: 600;

    letter-spacing: 0.05em;

    border: none;

    border-radius: 4px;

    padding: 16px 24px;

    cursor: pointer;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    transition:
      background-color 0.2s ease,
      opacity 0.2s ease;

    width: 100%;
  }

  .submit-btn:disabled {
    opacity: 0.75;
    cursor: not-allowed;
  }

  @media (min-width: 768px) {

    .submit-btn {
      width: auto;
      align-self: flex-start;
    }

  }

  .submit-btn:hover:not(:disabled) {
    background-color: #9d4300;
  }

  .icon-small {
    font-size: 20px;
  }

  /* Spinner rotation */
  .spinner {
    animation: rotateSpinner 1s linear infinite;
  }

  @keyframes rotateSpinner {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

</style>
