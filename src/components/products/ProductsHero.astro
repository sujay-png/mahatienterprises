---
import { Image } from 'astro:assets';
import bannerImg from '../../images/Product-Banner.webp';
---
<section class="products-hero-section">
  <!-- Background Image with Overlay -->
  <div 
    class="hero-bg" 
    style={`background-image: url('${bannerImg.src}');`}
  >
    <div class="hero-overlay"></div>
  </div>

  <!-- Content Container -->
  <div class="hero-content">
    <h1 class="hero-title">Our Products</h1>
    <p class="hero-subtitle">Mahati enterprises is a driving force in the green energy revolution, committed to a future of dependable and resilient clean energy.</p>
    <p class="hero-desc">Mahati Enterprises supplies and installs solar power systems, UPS backup solutions, and batteries. Every product below is available with installation and after-sales support, and our solar systems qualify for the PM Surya Ghar subsidy where applicable.</p>
  </div>
</section>

<style>
  .products-hero-section {
    position: relative;
    width: 100%;
    height: 614px;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(1.03);
    animation: slowZoom 12s ease-out forwards;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(11, 23, 39, 0.65); /* Warm dark tint over solar bg */
    backdrop-filter: blur(1px);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 0 24px;
    max-width: 896px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .hero-content {
      padding: 0 48px;
    }
  }

  .hero-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 38px;
    line-height: 1.15;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
    animation: fadeInSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @media (min-width: 768px) {
    .hero-title {
      font-size: 56px;
    }
  }

  .hero-subtitle {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 18px;
    line-height: 28px;
    color: rgba(255, 255, 255, 0.95);
    font-weight: 600;
    max-width: 720px;
    margin: 0 auto;
    animation: fadeInSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }

  .hero-desc {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 16px;
    line-height: 26px;
    color: rgba(255, 255, 255, 0.85);
    font-weight: 400;
    max-width: 720px;
    margin: 0 auto;
    animation: fadeInSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: 20px;
      line-height: 30px;
    }
    .hero-desc {
      font-size: 18px;
      line-height: 28px;
    }
  }

  @keyframes fadeInSlideUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slowZoom {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
</style>
