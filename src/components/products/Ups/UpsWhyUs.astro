<section class="ups-whyus-section">
  <div class="container">
    <h2 class="section-title">Why Choose Mahati Enterprises For Your UPS Solutions?</h2>
    <div class="reasons-grid">
      <div class="reason-card">
        <span class="material-symbols-outlined icon">verified</span>
        <div class="reason-content">
          <h4 class="reason-title">Top Quality:</h4>
          <p class="reason-desc">We offer robust models that guarantee durability.</p>
        </div>
      </div>

      <div class="reason-card">
        <span class="material-symbols-outlined icon">support_agent</span>
        <div class="reason-content">
          <h4 class="reason-title">Expert Advice:</h4>
          <p class="reason-desc">Our team helps you find exactly what you need without the confusing tech jargon.</p>
        </div>
      </div>

      <div class="reason-card">
        <span class="material-symbols-outlined icon">engineering</span>
        <div class="reason-content">
          <h4 class="reason-title">Easy Setup:</h4>
          <p class="reason-desc">We provide professional installation services so you don't have to lift a finger.</p>
        </div>
      </div>

      <div class="reason-card">
        <span class="material-symbols-outlined icon">handyman</span>
        <div class="reason-content">
          <h4 class="reason-title">Support &amp; Maintenance:</h4>
          <p class="reason-desc">We offer excellent after-sales support to keep your systems running smoothly.</p>
        </div>
      </div>

      <div class="reason-card">
        <span class="material-symbols-outlined icon">payments</span>
        <div class="reason-content">
          <h4 class="reason-title">Cost-effective:</h4>
          <p class="reason-desc">We give you great value for your money.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ups-whyus-section {
    background-color: #eff4ff; /* surface-container-low */
  }

  .container {
    max-width: 1024px;
    margin: 0 auto;
    padding: 80px 16px;
  }

  @media (min-width: 768px) {
    .container {
      padding-left: 40px;
      padding-right: 40px;
    }
  }

  .section-title {
    text-align: center;
    font-family: var(--font-heading, 'Manrope', system-ui, sans-serif);
    font-size: 32px;
    font-weight: 600;
    color: #0b1c30;
    margin-bottom: 40px;
  }

  .reasons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .reasons-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .reason-card {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .icon {
    font-size: 24px;
    color: #fd761a; /* secondary-container */
    flex-shrink: 0;
    margin-top: 4px;
  }

  .reason-title {
    font-family: var(--font-body, 'Hanken Grotesk', system-ui, sans-serif);
    font-size: 14px;
    font-weight: 600;
    color: #0b1c30;
    margin-bottom: 8px;
  }

  .reason-desc {
    font-family: var(--font-body, 'Hanken Grotesk', system-ui, sans-serif);
    font-size: 16px;
    color: #45464d;
    line-height: 1.5;
  }
</style>
