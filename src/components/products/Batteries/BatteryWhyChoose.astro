---
// BatteryWhyChoose.astro
---

<section class="why-choose-section">
  <div class="why-choose-container">
    
    <div class="visual-col">
      <div class="circle-container group">
        <div class="glow-bg"></div>
        <div class="grid-layout">
          <div class="feature-card card-up">
            <span class="material-symbols-outlined icon">verified_user</span>
            <h4 class="card-title">100% Genuine</h4>
            <p class="card-desc">Authentic products</p>
          </div>
          <div class="feature-card card-down">
            <span class="material-symbols-outlined icon">support_agent</span>
            <h4 class="card-title">Warranty Support</h4>
            <p class="card-desc">Full backing</p>
          </div>
          <div class="feature-card card-up">
            <span class="material-symbols-outlined icon">build</span>
            <h4 class="card-title">Expert Install</h4>
            <p class="card-desc">Professional setup</p>
          </div>
          <div class="feature-card card-down">
            <span class="material-symbols-outlined icon">recycling</span>
            <h4 class="card-title">Eco-Friendly</h4>
            <p class="card-desc">Safe disposal</p>
          </div>
        </div>
      </div>
    </div>
    
    <div class="content-col">
      <h2 class="section-title">Why Choose Mahati Enterprises for Your Battery Needs?</h2>
      
      <ul class="reasons-list">
        <li>
          <div class="icon-box">
            <span class="material-symbols-outlined">verified</span>
          </div>
          <div class="reason-text">
            <h4 class="reason-title">Extensive Range</h4>
            <p class="reason-desc">From basic SLA to advanced Lithium Ion, we have the right fit.</p>
          </div>
        </li>
        <li>
          <div class="icon-box">
            <span class="material-symbols-outlined">handyman</span>
          </div>
          <div class="reason-text">
            <h4 class="reason-title">Expert Installation</h4>
            <p class="reason-desc">Our technicians ensure safe, compliant, and optimal setup.</p>
          </div>
        </li>
        <li>
          <div class="icon-box">
            <span class="material-symbols-outlined">support</span>
          </div>
          <div class="reason-text">
            <h4 class="reason-title">After-Sales Support</h4>
            <p class="reason-desc">Comprehensive maintenance, testing, and replacement services.</p>
          </div>
        </li>
        <li>
          <div class="icon-box">
            <span class="material-symbols-outlined">sync</span>
          </div>
          <div class="reason-text">
            <h4 class="reason-title">Safe Disposal</h4>
            <p class="reason-desc">We follow strict environmental protocols for old battery recycling.</p>
          </div>
        </li>
      </ul>
    </div>

  </div>
</section>

<style>
  .why-choose-section {
    padding: 80px 24px;
    background-color: var(--color-bg);
  }

  @media (min-width: 1024px) {
    .why-choose-section {
      padding: 120px 24px;
    }
  }

  .why-choose-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 64px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .why-choose-container {
      grid-template-columns: 1fr 1fr;
    }
  }

  .visual-col {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .circle-container {
    position: relative;
    width: 100%;
    max-width: 500px;
    aspect-ratio: 1 / 1;
    background-color: #eff4ff; /* surface-container-low */
    border-radius: 50%;
    padding: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 32px rgba(15, 23, 42, 0.12);
    transition: all 0.3s ease;
  }

  .glow-bg {
    position: absolute;
    inset: 0;
    background-color: rgba(244, 125, 32, 0.05); /* mahati-orange/5 */
    border-radius: 50%;
    filter: blur(40px);
    transition: background-color 0.3s ease;
  }

  .circle-container:hover .glow-bg {
    background-color: rgba(244, 125, 32, 0.1);
  }

  .grid-layout {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .feature-card {
    background-color: #ffffff;
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .card-up {
    transform: translateY(-24px);
  }

  .card-down {
    transform: translateY(24px);
  }

  .feature-card .icon {
    font-size: 32px;
    color: var(--color-primary);
    margin-bottom: 12px;
  }

  .card-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 16px;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .card-desc {
    font-family: var(--font-body, sans-serif);
    font-size: 14px;
    color: #475569;
  }

  .content-col {
    display: flex;
    flex-direction: column;
  }

  .section-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 32px;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 40px;
    line-height: 1.2;
  }

  @media (min-width: 1024px) {
    .section-title {
      font-size: 40px;
    }
  }

  .reasons-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .reasons-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .icon-box {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: rgba(244, 125, 32, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 4px;
  }

  .icon-box .material-symbols-outlined {
    font-size: 24px;
    color: var(--color-secondary-container);
  }

  .reason-text {
    display: flex;
    flex-direction: column;
  }

  .reason-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 4px;
  }

  .reason-desc {
    font-family: var(--font-body, sans-serif);
    font-size: 16px;
    color: #475569;
    line-height: 1.6;
  }
</style>
