---
// BatteryCTA.astro
---

<section class="cta-section">
  <div class="cta-bg-image"></div>
  <div class="glow-bg"></div>
  
  <div class="cta-container">
    <h2 class="cta-title">Power Your Operations with Confidence</h2>
    <p class="cta-desc">
      Get in touch with our experts today to find the perfect battery backup solution for your specific requirements. We ensure reliable, uninterrupted power when you need it most.
    </p>
    
    <div class="cta-actions">
      <a href="/contact" class="btn-primary">
        Contact Us Now
        <span class="material-symbols-outlined">arrow_forward</span>
      </a>
      <a href="/products" class="btn-secondary">
        View Other Products
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    position: relative;
    padding: 80px 24px;
    background-color: var(--color-primary); /* mahati-navy */
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .cta-section {
      padding: 120px 24px;
    }
  }

  .cta-bg-image {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1620916297397-a4a5402a3c6c?q=80&w=2070&auto=format&fit=crop');
    background-size: cover;
    background-position: center;
    opacity: 0.1;
    mix-blend-mode: overlay;
    z-index: 0;
  }

  .glow-bg {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background-color: rgba(244, 125, 32, 0.1); /* mahati-orange/10 */
    border-top-left-radius: 9999px;
    border-bottom-left-radius: 9999px;
    filter: blur(60px);
    z-index: 0;
  }

  .cta-container {
    position: relative;
    z-index: 10;
    max-width: 768px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-title {
    font-family: var(--font-heading, sans-serif);
    font-size: 32px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 24px;
    line-height: 1.2;
  }

  @media (min-width: 1024px) {
    .cta-title {
      font-size: 40px;
    }
  }

  .cta-desc {
    font-family: var(--font-body, sans-serif);
    font-size: 18px;
    color: #cbd5e1; /* slate-300 */
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 16px;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 640px) {
    .cta-actions {
      flex-direction: row;
    }
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-secondary-container); /* mahati-orange */
    color: #ffffff;
    padding: 16px 32px;
    border-radius: 9999px;
    font-family: var(--font-body, sans-serif);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s ease;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.2);
  }

  .btn-primary:hover {
    background-color: #ea580c; /* orange-600 */
  }

  .btn-primary .material-symbols-outlined {
    font-size: 20px;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
    background-color: transparent;
    border-radius: 9999px;
    font-family: var(--font-body, sans-serif);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>
