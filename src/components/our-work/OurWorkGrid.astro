---
import imgVedvyasa from "../../images/VedvyasTantra3.jpg";
import imgAJ from "../../images/AJ institute2.jpg";
import imgChandra from "../../images/Chandrakanth kramballi3.jpg";
import imgRaghavendra from "../../images/raghavendra-hero.webp";
import imgHarikrishna from "../../images/Portfolio solar panel.jpeg";
import imgShrikiran from "../../images/DR Hebbar solar system.jpeg";

interface Props {
  limit?: number;
  showViewAll?: boolean;
}

const { limit, showViewAll = false } = Astro.props;

const projects = [
  {
    title: "Vedavyasa Tantry",
    category: "Residential Rooftop Installation",
    location: "Marpalli, Udupi",
    link: "/our-work/vedavyasa-tantry",
    img: imgVedvyasa.src,
  },
  {
    title: "AJ Institute",
    category: "Institutional Solar Array",
    location: "Kottara, Mangalore",
    link: "/our-work/aj-institute",
    img: imgAJ.src,
  },
  {
    title: "Chandrakanth",
    category: "Residential Solar Solution",
    location: "Kramballi, Udupi",
    link: "/our-work/chandrakanth",
    img: imgChandra.src,
  },
  {
    title: "Raghavendra KG",
    category: "Solar Installation",
    location: "Padigar, Udupi",
    link: "/our-work/raghavendra",
    img: imgRaghavendra.src,
  },
  {
    title: "Harikrishna Udupa",
    category: "On-Grid Solar Installation",
    location: "Kunjur, Udupi",
    link: "/our-work/harikrishna-udupa",
    img: imgHarikrishna.src,
  },
  {
    title: "Dr Shrikiran & Dr Arathi Hebbar",
    category: "Hybrid Solar Installation",
    location: "Hayagreeva Nagara, Udupi",
    link: "/our-work/dr-shrikiran-hebbar",
    img: imgShrikiran.src,
  },
];
---

<section class="our-work-grid-section">
  <div class="grid-container">
    <div class="section-header">
      <h2 class="section-title">Solar Projects That Speak for Themselves</h2>
      <p class="section-subtitle">
        At Mahati Enterprises, we believe the best proof of our work is the work
        itself. Browse through our completed solar energy projects — each one
        designed, supplied, and installed to deliver maximum efficiency,
        long-term savings, and complete peace of mind for our customers.
      </p>
    </div>

    <div class="projects-grid">
      {
        (limit ? projects.slice(0, limit) : projects).map((project) => (
          <article class="project-card">
            <div class="image-wrapper">
              <img
                src={project.img}
                alt={project.title}
                class="project-img"
                loading="lazy"
              />
              <div class="location-badge">
                <span class="material-symbols-outlined location-icon">
                  location_on
                </span>
                <span class="location-text">{project.location}</span>
              </div>
            </div>

            <div class="project-content">
              <h3 class="project-title">{project.title}</h3>
              <p class="project-category">{project.category}</p>
              <a href={project.link} class="view-link">
                View Project
                <span class="material-symbols-outlined link-icon">
                  arrow_forward
                </span>
              </a>
            </div>
          </article>
        ))
      }
    </div>

    {showViewAll && (
      <div class="view-all-container">
        <a href="/our-work" class="btn-primary view-all-btn">
          View All Projects <span class="material-symbols-outlined btn-icon">arrow_forward</span>
        </a>
      </div>
    )}

  </div>
</section>

<style>
  .our-work-grid-section {
    padding: 80px 24px;
    background-color: var(--color-bg, #f8f9ff);
  }

  .grid-container {
    max-width: 1440px;
    margin: 0 auto;
  }

  /* Header */
  .section-header {
    text-align: center;
    margin-bottom: 80px;
  }

  .section-title {
    font-family: var(--font-heading, "Manrope", sans-serif);
    font-size: 32px;
    font-weight: 600;
    color: #0b1c30;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    font-family: var(--font-body, "Hanken Grotesk", sans-serif);
    font-size: 16px;
    line-height: 24px;
    color: #45464d;
    max-width: 768px;
    margin: 0 auto;
  }

  /* Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Project Card */
  .project-card {
    background-color: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0px 4px 20px rgba(15, 23, 42, 0.05);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0px 12px 32px rgba(15, 23, 42, 0.08);
  }

  /* Image Wrapper */
  .image-wrapper {
    position: relative;
    height: 256px;
    overflow: hidden;
  }

  .project-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-img {
    transform: scale(1.05);
  }

  .location-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background-color: rgba(248, 249, 255, 0.9);
    backdrop-filter: blur(4px);
    padding: 4px 12px;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .location-icon {
    font-size: 14px !important;
    color: #9d4300;
  }

  .location-text {
    font-family: var(--font-body, "Hanken Grotesk", sans-serif);
    font-size: 12px;
    font-weight: 500;
    color: #0b1c30;
  }

  /* Card Content */
  .project-content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .project-title {
    font-family: var(--font-heading, "Manrope", sans-serif);
    font-size: 24px;
    font-weight: 600;
    color: #0b1c30;
    margin-bottom: 4px;
  }

  .project-category {
    font-family: var(--font-body, "Hanken Grotesk", sans-serif);
    font-size: 14px;
    color: #45464d;
    margin-bottom: 24px;
    flex-grow: 1;
  }

  .view-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body, "Hanken Grotesk", sans-serif);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: #131b2e;
    text-decoration: none;
    width: fit-content;
    transition: color 0.2s ease;
  }

  .view-link:hover {
    color: #9d4300;
  }

  .link-icon {
    font-size: 18px !important;
    transition: transform 0.2s ease;
  }

  .view-link:hover .link-icon {
    transform: translateX(4px);
  }

  /* View All Button */
  .view-all-container {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }

  .view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--c-primary, #0b1727);
    color: #ffffff;
    padding: 14px 28px;
    border-radius: 6px;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .view-all-btn:hover {
    background-color: var(--c-secondary, #fd761a);
    transform: translateY(-2px);
  }

  .btn-icon {
    font-size: 20px !important;
    transition: transform 0.2s ease;
  }

  .view-all-btn:hover .btn-icon {
    transform: translateX(4px);
  }
</style>
