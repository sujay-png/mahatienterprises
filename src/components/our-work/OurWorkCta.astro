<section class="cta-section">
  <div class="cta-card">
    <div class="decorative-shape"></div>
    
    <div class="cta-content">
      <h2 class="cta-title">Ready to Start Your Solar Project?</h2>
      <p class="cta-description">Join homeowners and institutions across Karnataka who've made the switch to clean, affordable solar energy with Mahati Enterprises.</p>
      
      <a href="/contact" class="cta-button">
        <span class="material-symbols-outlined icon">solar_power</span>
        Get a Consultation
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    background-color: #e5eeff;
    padding: 80px 24px;
  }

  .cta-card {
    max-width: 896px;
    margin: 0 auto;
    text-align: center;
    background-color: #ffffff;
    border-radius: 12px;
    padding: 48px;
    box-shadow: 0px 4px 20px rgba(15, 23, 42, 0.05);
    position: relative;
    overflow: hidden;
  }

  .decorative-shape {
    position: absolute;
    top: 0;
    right: 0;
    width: 256px;
    height: 256px;
    background-color: #d3e4fe;
    border-bottom-left-radius: 9999px;
    opacity: 0.5;
    z-index: 0;
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 32px;
    font-weight: 600;
    color: #0b1c30;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }

  .cta-description {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 16px;
    line-height: 24px;
    color: #45464d;
    margin-bottom: 48px;
    max-width: 600px;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #fd761a;
    color: #ffffff;
    padding: 12px 48px;
    border-radius: 9999px;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .cta-button:hover {
    background-color: #9d4300;
  }

  .icon {
    font-size: 20px !important;
  }
</style>
