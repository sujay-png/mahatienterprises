---
interface Props {
  productsData: {
    eyebrow: string;
    title: string;
    items: {
      image: string;
      alt: string;
      title: string;
      desc: string;
      benefitsHeading: string;
      benefits: string[];
      link: string;
    }[];
  };
}
const { productsData } = Astro.props;
---

<section class="section" id="products">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{productsData.eyebrow}</span>
      <h2 style="margin-top:12px;">{productsData.title}</h2>
    </div>
    <div class="product-grid">
      {productsData.items.map(product => (
        <div class="premium-card product-card">
          <img src={product.image} alt={product.alt} loading="lazy" />
          <div class="product-body">
            <h3>{product.title}</h3>
            <p class="desc">{product.desc}</p>
            <h5>{product.benefitsHeading}</h5>
            <ul>
              {product.benefits.map(benefit => (
                <li>{benefit}</li>
              ))}
            </ul>
            <a href={product.link} class="card-btn">Enquire Now <span class="material-symbols-outlined" style="font-size:16px;">arrow_forward</span></a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section { padding: 76px 0; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  
  .eyebrow {
    font-family: var(--font-body);
    font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--color-secondary);
  }
  
  .section-head { max-width: 700px; margin-bottom: 40px; }
  .section-head h2 { font-family: var(--font-heading); font-weight: 800; font-size: clamp(26px,3.4vw,36px); color: var(--color-primary); }
  
  .product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 980px) { .product-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 620px) { .product-grid { grid-template-columns: 1fr; } }
  
  .product-card { overflow: hidden; display: flex; flex-direction: column; }
  .product-card img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .product-body { padding: 24px; display: flex; flex-direction: column; flex-grow: 1; }
  .product-body h3 { font-family: var(--font-heading); font-size: 18px; font-weight: 700; margin-bottom: 10px; }
  .product-body p.desc { font-size: 14.5px; color: var(--color-text-muted); margin-bottom: 14px; line-height: 1.55; }
  .product-body h5 { font-family: var(--font-heading); font-size: 12.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--color-secondary); margin-bottom: 10px; }
  .product-body ul { display: flex; flex-direction: column; gap: 6px; margin-bottom: 18px; list-style: none; padding: 0; flex-grow: 1; }
  .product-body li { font-size: 14px; color: var(--color-text-dark); display: flex; gap: 8px; line-height: 1.5; }
  .product-body li::before { content: ""; width: 5px; height: 5px; border-radius: 50%; background: var(--color-secondary-container); margin-top: 8px; flex-shrink: 0; }
  
  .card-btn {
    display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-heading);
    font-size: 13.5px; font-weight: 700; color: var(--color-on-secondary);
    background: var(--color-primary); padding: 10px 18px; border-radius: 999px;
    align-self: flex-start; text-decoration: none; transition: background .2s ease;
  }
  .card-btn:hover { background: var(--color-secondary); }
</style>
