---
interface Props {
  whyChooseUsData: {
    eyebrow: string;
    title: string;
    description: string;
    benefitsHeading: string;
    benefits: string[];
    carouselData: {
      eyebrow: string;
      title: string;
      items: {
        num: string;
        icon: string;
        title: string;
        desc: string;
      }[];
    };
  };
}
const { whyChooseUsData } = Astro.props;
---

<section class="section" id="why-choose">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{whyChooseUsData.eyebrow}</span>
      <h2 style="margin-top:12px;">{whyChooseUsData.title}</h2>
    </div>
    <p
      style="color: var(--color-text-muted); font-size: 16px; max-width: 74ch; margin-bottom: 8px; line-height: 1.55;"
    >
      {whyChooseUsData.description}
    </p>
    <h3 class="subhead">{whyChooseUsData.benefitsHeading}</h3>
    <ul class="benefit-grid">
      {
        whyChooseUsData.benefits.map((benefit) => (
          <li>
            <span class="material-symbols-outlined">check_circle</span>
            {benefit}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section class="section on-surface" id="why-mahati">
  <div class="wrap">
    <div class="why-head-row">
      <div>
        <span class="eyebrow">{whyChooseUsData.carouselData.eyebrow}</span>
        <h2
          style="margin-top:12px; font-family: var(--font-heading); font-weight:800; font-size: clamp(26px,3.4vw,36px); color: var(--color-primary);"
        >
          {whyChooseUsData.carouselData.title}
        </h2>
      </div>
      <div class="why-arrows">
        <button class="why-arrow" id="whyPrev" aria-label="Previous reason"
          ><span class="material-symbols-outlined">arrow_back</span></button
        >
        <button class="why-arrow" id="whyNext" aria-label="Next reason"
          ><span class="material-symbols-outlined">arrow_forward</span></button
        >
      </div>
    </div>

    <div class="why-carousel">
      <div
        class="why-track"
        id="whyTrack"
        tabindex="0"
        aria-label="Reasons to choose Mahati Enterprises, scrollable"
      >
        {
          whyChooseUsData.carouselData.items.map((item) => (
            <div class="why-card">
              <span class="num">{item.num}</span>
              <span class="material-symbols-outlined why-icon">
                {item.icon}
              </span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="why-dots" id="whyDots"></div>
  </div>
</section>

<style>
  .section {
    padding: 76px 0;
  }
  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .eyebrow {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-secondary);
  }

  .section-head {
    max-width: 700px;
    margin-bottom: 40px;
  }
  .section-head h2 {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(26px, 3.4vw, 36px);
    color: var(--color-primary);
  }

  .subhead {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 800;
    margin: 22px 0 16px;
    color: var(--color-primary);
  }

  .benefit-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    list-style: none;
    padding: 0;
  }
  @media (max-width: 640px) {
    .benefit-grid {
      grid-template-columns: 1fr;
    }
  }
  .benefit-grid li {
    display: flex;
    gap: 10px;
    padding: 4px 0;
    color: var(--color-text-dark);
    font-size: 15.5px;
  }
  .benefit-grid .material-symbols-outlined {
    color: var(--color-secondary-container);
    font-size: 20px;
  }

  /* Carousel */
  .on-surface .wrap {
    background: var(--color-surface-container);
    border-radius: 28px;
    padding: 56px 44px;
  }
  @media (max-width: 768px) {
    .on-surface .wrap {
      padding: 40px 24px;
    }
  }

  .why-head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 32px;
  }

  .why-arrows {
    display: flex;
    gap: 10px;
  }
  .why-arrow {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-card-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-primary);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }
  .why-arrow:hover {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
    transform: translateY(-2px);
  }
  .why-arrow:disabled {
    opacity: 0.35;
    cursor: default;
    transform: none;
    background: var(--color-card-bg);
    color: var(--color-primary);
  }
  .why-arrow .material-symbols-outlined {
    font-size: 20px;
  }

  .why-carousel {
    position: relative;
  }
  .why-track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 4px 14px;
    margin: -4px -4px 0;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .why-track::-webkit-scrollbar {
    display: none;
  }

  .why-card {
    flex: 0 0 auto;
    width: 280px;
    scroll-snap-align: start;
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: 18px;
    padding: 30px 26px;
    cursor: grab;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }
  .why-card:active {
    cursor: grabbing;
  }
  .why-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.1);
    border-color: var(--color-secondary-container);
  }
  .why-card .num {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-on-primary-container);
    margin-bottom: 20px;
  }
  .why-card .material-symbols-outlined.why-icon {
    font-size: 28px;
    color: var(--color-secondary-container);
    display: block;
    margin-bottom: 16px;
  }
  .why-card h3 {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--color-primary);
  }
  .why-card p {
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .why-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 26px;
  }
  :global(.why-dot) {
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: var(--color-border);
    cursor: pointer;
    transition:
      background 0.2s ease,
      width 0.2s ease,
      border-radius 0.2s ease;
  }
  :global(.why-dot.active) {
    width: 24px;
    border-radius: 5px;
    background: var(--color-secondary-container);
  }

  @media (max-width: 560px) {
    .why-card {
      width: 78vw;
    }
  }
</style>

<script>
  function initCarousel() {
    const track = document.getElementById("whyTrack");
    const dotsWrap = document.getElementById("whyDots");
    const prevBtn = document.getElementById("whyPrev") as HTMLButtonElement;
    const nextBtn = document.getElementById("whyNext") as HTMLButtonElement;

    if (!track || !dotsWrap || !prevBtn || !nextBtn) return;

    dotsWrap.innerHTML = "";

    const cards = Array.from(track.children) as HTMLElement[];
    const gap = 20;

    cards.forEach((_, i) => {
      const dot = document.createElement("button");
      dot.className = "why-dot" + (i === 0 ? " active" : "");
      dot.setAttribute("aria-label", "Go to reason " + (i + 1));
      dot.addEventListener("click", () => {
        track.scrollTo({
          left: cards[i].offsetLeft - track.offsetLeft,
          behavior: "smooth",
        });
      });
      dotsWrap.appendChild(dot);
    });

    const dots = Array.from(dotsWrap.children) as HTMLElement[];

    function step() {
      return cards[0].getBoundingClientRect().width + gap;
    }

    function updateUI() {
      if (!track) return;
      const trackLeft = track.getBoundingClientRect().left;
      let closest = 0,
        minDist = Infinity;
      cards.forEach((c, i) => {
        const dist = Math.abs(c.getBoundingClientRect().left - trackLeft);
        if (dist < minDist) {
          minDist = dist;
          closest = i;
        }
      });
      dots.forEach((d, i) => d.classList.toggle("active", i === closest));
      prevBtn.disabled = track.scrollLeft <= 4;
      nextBtn.disabled =
        track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
    }

    let raf: number | null = null;
    track.addEventListener("scroll", () => {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(updateUI);
    });

    prevBtn.addEventListener("click", () =>
      track.scrollBy({ left: -step(), behavior: "smooth" }),
    );
    nextBtn.addEventListener("click", () =>
      track.scrollBy({ left: step(), behavior: "smooth" }),
    );

    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") {
        track.scrollBy({ left: step(), behavior: "smooth" });
      }
      if (e.key === "ArrowLeft") {
        track.scrollBy({ left: -step(), behavior: "smooth" });
      }
    });

    /* drag-to-scroll with mouse */
    let isDown = false,
      startX = 0,
      startScroll = 0;
    track.addEventListener("mousedown", (e) => {
      isDown = true;
      startX = e.pageX;
      startScroll = track.scrollLeft;
      track.style.scrollBehavior = "auto";
    });
    window.addEventListener("mouseup", () => {
      isDown = false;
      track.style.scrollBehavior = "smooth";
    });
    window.addEventListener("mousemove", (e) => {
      if (!isDown) return;
      track.scrollLeft = startScroll - (e.pageX - startX);
    });

    updateUI();
    window.addEventListener("resize", updateUI);
  }

  document.addEventListener("astro:page-load", initCarousel);
  if (
    document.readyState === "complete" ||
    document.readyState === "interactive"
  ) {
    initCarousel();
  } else {
    document.addEventListener("DOMContentLoaded", initCarousel);
  }
</script>
