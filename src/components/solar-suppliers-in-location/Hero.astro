---
interface Props {
  heroData: {
    h1: string;
    h2: string;
    paragraphs: string[];
    primaryButton: { label: string; link: string; };
    secondaryButton: { label: string; link: string; };
    image: { src: string; alt: string; };
  };
}
const { heroData } = Astro.props;
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <h1>{heroData.h1}</h1>
      <h2>{heroData.h2}</h2>
      {heroData.paragraphs.map(p => (
        <p>{p}</p>
      ))}
      <div class="hero-actions">
        <a href={heroData.primaryButton.link} class="btn btn-primary">
          {heroData.primaryButton.label} <span class="material-symbols-outlined">arrow_forward</span>
        </a>
        <a href={heroData.secondaryButton.link} class="btn btn-ghost">
          {heroData.secondaryButton.label}
        </a>
      </div>
    </div>
    <div class="hero-image">
      <img src={heroData.image.src} alt={heroData.image.alt} />
    </div>
  </div>
</section>

<style>
  .hero { padding: 56px 0 0; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 48px; align-items: center; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero h1 { font-family: var(--font-heading); font-weight: 800; font-size: 14px; letter-spacing: .12em; text-transform: uppercase; color: var(--color-secondary); margin-bottom: 14px; }
  .hero h2 { font-family: var(--font-heading); font-weight: 800; font-size: clamp(30px,4.6vw,48px); line-height: 1.12; color: var(--color-primary); margin-bottom: 20px; }
  .hero p { color: var(--color-text-muted); font-size: 16.5px; max-width: 52ch; margin-bottom: 14px; line-height: 1.55; }
  .hero-actions { display: flex; gap: 14px; margin-top: 26px; flex-wrap: wrap; }
  .hero-image { border-radius: 20px; overflow: hidden; border: 1px solid var(--color-border); box-shadow: 0 20px 44px rgba(0,0,0,.10); }
  .hero-image img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4/3; }
  
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-heading); font-weight: 700; font-size: 15px;
    padding: 13px 26px; border-radius: 999px; border: 1.5px solid transparent; cursor: pointer;
    transition: transform .25s ease, box-shadow .25s ease;
    text-decoration: none;
  }
  .btn-primary { background: var(--color-secondary-container); color: var(--color-on-secondary); box-shadow: 0 10px 22px rgba(253,118,26,.28); }
  .btn-primary:hover { transform: translateY(-2px); }
  .btn-ghost { background: transparent; color: var(--color-primary); border-color: var(--color-border); }
</style>
