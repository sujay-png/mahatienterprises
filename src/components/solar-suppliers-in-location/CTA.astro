---
const { ctaData } = Astro.props;
---

<section class="section" style="padding-top:0;">
  <div class="wrap">
    <div class="cta-band">
      <div>
        <h2>{ctaData.title}</h2>
        <p>{ctaData.description}</p>
      </div>
      <a href={ctaData.button.link} class="btn btn-primary">
        {ctaData.button.label} <span class="material-symbols-outlined">arrow_forward</span>
      </a>
    </div>
  </div>
</section>

<style>
  .section { padding: 76px 0; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  
  .cta-band {
    background: var(--color-primary); border-radius: 24px; padding: 56px 44px; color: #fff;
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px;
  }
  .cta-band h2 { font-family: var(--font-heading); font-size: clamp(24px,3vw,32px); font-weight: 800; max-width: 20ch; color: #fff; margin-bottom: 0; }
  .cta-band p { color: rgba(255,255,255,.62); margin-top: 10px; max-width: 46ch; font-size: 16px; }
  
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-heading); font-weight: 700; font-size: 15px;
    padding: 13px 26px; border-radius: 999px; border: 1.5px solid transparent; cursor: pointer;
    transition: transform .25s ease, box-shadow .25s ease; text-decoration: none;
  }
  .btn-primary { background: var(--color-secondary-container); color: var(--color-on-secondary); box-shadow: 0 10px 22px rgba(253,118,26,.28); }
  .btn-primary:hover { transform: translateY(-2px); }
</style>
