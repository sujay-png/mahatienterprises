---
// BlogSidebarForm.astro
---
<div class="blog-sidebar-form">
  <h3>Get in Touch</h3>
  <p>Have questions about our solar solutions? Let us help you.</p>

  <form onsubmit="event.preventDefault();">
    <div class="form-group">
      <label for="blog-name">Name</label>
      <input type="text" id="blog-name" placeholder="Your Name" required />
    </div>

    <div class="form-group">
      <label for="blog-email">Email</label>
      <input type="email" id="blog-email" placeholder="john@example.com" required />
    </div>

    <div class="form-group">
      <label for="blog-phone">Phone Number</label>
      <input type="tel" id="blog-phone" placeholder="+91 XXXXX XXXXX" required />
    </div>

    <button type="submit" class="submit-btn">
      Request Callback
      <span class="material-symbols-outlined btn-icon">arrow_forward</span>
    </button>
  </form>
</div>

<style>
  .blog-sidebar-form {
    background: #ffffff;
    border: 1px solid #e5e9e3;
    border-radius: 16px;
    padding: 32px 24px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
  }

  .blog-sidebar-form h3 {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 22px;
    font-weight: 700;
    color: #172018;
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .blog-sidebar-form p {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 14px;
    color: #697269;
    margin-bottom: 24px;
    line-height: 1.5;
  }

  .form-group {
    margin-bottom: 16px;
  }

  .form-group label {
    display: block;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 13px;
    font-weight: 600;
    color: #344034;
    margin-bottom: 6px;
  }

  .form-group input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #dce2d9;
    border-radius: 8px;
    background: #fcfcfc;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 14px;
    color: #172018;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .form-group input:focus {
    outline: none;
    border-color: #78954d;
    background: #ffffff;
    box-shadow: 0 0 0 3px rgba(120, 149, 77, 0.1);
  }

  .form-group input::placeholder {
    color: #aeb4ab;
  }

  .submit-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #172018;
    color: #ffffff;
    border: none;
    padding: 14px 24px;
    border-radius: 8px;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    margin-top: 24px;
  }

  .submit-btn:hover {
    background: #78954d;
    transform: translateY(-2px);
  }

  .btn-icon {
    font-size: 18px !important;
    transition: transform 0.2s ease;
  }

  .submit-btn:hover .btn-icon {
    transform: translateX(4px);
  }
</style>
