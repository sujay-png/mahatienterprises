---
import { ctaData } from '../../data/about/cta';
---

<section class="cta-section">
  <div class="cta-container">
    <h2 class="cta-title">{ctaData?.title}</h2>
    <p class="cta-description">{ctaData?.description}</p>
    <a href={ctaData?.buttonLink || "/contact"} class="cta-button">
      {ctaData?.buttonText}
    </a>
  </div>
</section>

<style>
  /* Deep Midnight Navy Background matching image spec */
  .cta-section {
    background-color: #0d1424;
    padding: 110px 24px;
    width: 100%;
    text-align: center;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cta-container {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Exact Font & Layout Settings */
  .cta-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 32px;
    line-height: 1.25;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 24px;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .cta-title {
      font-size: 36px;
    }
  }

  .cta-description {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 15px;
    line-height: 24px;
    color: #c3cbda;
    max-width: 700px;
    margin-bottom: 40px;
  }

  /* Vibrant Orange Button with Light-Color Hover State */
  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #ff6b1c; /* Base vibrant orange */
    color: #ffffff;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 15px;
    font-weight: 600;
    padding: 16px 42px;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0px 4px 12px rgba(255, 107, 28, 0.25);
  }

  /* Hover state turns lighter as requested */
  .cta-button:hover {
    background-color: #ff8c4a; /* Lighter orange shade */
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0px 8px 20px rgba(255, 140, 74, 0.35);
  }
</style>