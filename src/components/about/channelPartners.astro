---
---

<section class="channel-partners-section">
  <div class="channel-partners-container">

    <!-- Section Header -->
    <div class="channel-partners-header">

      <span class="channel-partners-subtitle">
        MAHATI ENTERPRISES
      </span>

      <h2 class="channel-partners-title">
        Our Channel Partners
      </h2>

      <p class="channel-partners-description">
        Our aim is to develop long-term relationships with our channel partners,
        to drive sustainable growth and deliver solid business results and profitability.
      </p>

    </div>

  </div>
</section>


<style>

  /* ========================================
     CHANNEL PARTNERS SECTION
  ======================================== */

  .channel-partners-section {
    width: 100%;
    background-color: #ffffff;
    padding: 36px 24px 90px;
  }


  .channel-partners-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }


  /* ========================================
     HEADER
  ======================================== */

  .channel-partners-header {
    text-align: center;
  }


  /* Small top label */

  .channel-partners-subtitle {
    display: block;

    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.4;
    font-weight: 400;

    color: var(--color-primary, #000000);

    margin-bottom: 18px;
  }


  /* Main heading */

  .channel-partners-title {
    font-family: var(--font-heading);

    font-size: 42px;
    line-height: 1.2;
    font-weight: 700;

    color: var(--color-secondary, #9d4300);

    margin: 0 auto 26px;

    letter-spacing: -0.02em;
  }


  /* Description */

  .channel-partners-description {
    font-family: var(--font-body);

    font-size: 16px;
    line-height: 1.6;
    font-weight: 400;

    color: var(--color-primary, #000000);

    max-width: 1100px;

    margin: 0 auto;
  }


  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 1000px) {

    .channel-partners-section {
      padding: 40px 24px 75px;
    }

    .channel-partners-title {
      font-size: 38px;
    }

    .channel-partners-description {
      font-size: 15px;
      max-width: 850px;
    }

  }


  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 767px) {

    .channel-partners-section {
      padding: 50px 20px 65px;
    }


    .channel-partners-subtitle {
      font-size: 14px;
      margin-bottom: 12px;
    }


    .channel-partners-title {
      font-size: 32px;
      line-height: 1.2;
      margin-bottom: 18px;
    }


    .channel-partners-description {
      font-size: 14px;
      line-height: 1.6;
    }

  }

</style>