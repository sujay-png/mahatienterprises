---
import { transformingEnergyData } from '../../data/about/transformingEnergy';
---

<section class="transforming-section">
  <div class="transforming-container">
    <div class="transforming-grid">
      
      <!-- Text Content Column -->
      <div class="text-column">
        <h2 class="section-title">
          {transformingEnergyData?.title || "Transforming Renewable Energy"}
        </h2>
        <p class="paragraph">
          {transformingEnergyData?.paragraph1}
        </p>
        <p class="paragraph">
          {transformingEnergyData?.paragraph2}
        </p>
      </div>

      <!-- Image Column -->
      <div class="image-column">
        <div class="image-wrapper">
          <img 
            src={transformingEnergyData?.imageSrc} 
            alt={transformingEnergyData?.imageAlt} 
            class="storage-img" 
          />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Base Section Layout */
  .transforming-section {
    background-color: #ffffff;
    padding: 80px 24px;
    width: 100%;
  }

  .transforming-container {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  /* Responsive Grid System */
  .transforming-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 768px) {
    .transforming-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 64px;
    }
  }

  /* Typography & Text Styling */
  .text-column {
    display: flex;
    flex-direction: column;
  }

  .section-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 32px;
    line-height: 40px;
    font-weight: 700;
    color: var(--color-primary, #0b1727);
    margin-bottom: 24px;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .section-title {
      font-size: 40px;
      line-height: 48px;
    }
  }

  .paragraph {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 15px;
    line-height: 24px;
    color: #475569;
    margin-bottom: 20px;
  }

  .paragraph:last-child {
    margin-bottom: 0;
  }

  /* Image Area Styling */
  .image-column {
    width: 100%;
  }

  .image-wrapper {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0px 12px 32px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.04);
    aspect-ratio: 1 / 1;
    background-color: #f8fafc;
  }

  @media (min-width: 768px) {
    .image-wrapper {
      aspect-ratio: 16 / 10;
    }
  }

  .storage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-wrapper:hover .storage-img {
    transform: scale(1.04);
  }
</style>