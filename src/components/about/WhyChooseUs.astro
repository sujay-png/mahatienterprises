---
import { whyChooseUsData } from '../../data/about/whyChooseUs';
---

<section class="why-choose-section">
  <div class="why-choose-container">
    
    <!-- Section Header -->
    <div class="header-content">
      <span class="subtitle">{whyChooseUsData?.subtitle}</span>
      <h2 class="title">{whyChooseUsData?.title}</h2>
      <p class="description">{whyChooseUsData?.description}</p>
    </div>

    <!-- 3-Column Feature Cards Grid -->
    <div class="feature-grid">
      {whyChooseUsData?.items?.map((item, index) => (
        <div class="feature-card premium-card">
          
          <!-- Icon Circle Container using custom background variants -->
          <div class={`icon-wrapper icon-variant-${index + 1}`}>
            <span class="material-symbols-outlined icon">{item.icon}</span>
          </div>

          <!-- Content Body -->
          <h3 class="card-title">{item.title}</h3>
          <p class="card-desc">{item.description}</p>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Base Section Background using global variable */
  .why-choose-section {
    background-color: var(--color-surface-container, #e5eeff);
    padding: 80px 24px 96px 24px;
    width: 100%;
  }

  .why-choose-container {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  /* Header Layout */
  .header-content {
    text-align: center;
    margin-bottom: 56px;
  }

  .subtitle {
    display: block;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary, #9d4300);
    margin-bottom: 12px;
  }

  .title {
    font-family: var(--font-heading);
    font-size: 32px;
    line-height: 1.25;
    font-weight: 700;
    color: var(--color-primary, #000000);
    max-width: 640px;
    margin: 0 auto 16px auto;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 40px;
    }
  }

  .description {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 24px;
    color: var(--color-on-primary-container, #7c839b);
    max-width: 680px;
    margin: 0 auto;
  }

  /* 3-Column Responsive Grid */
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .feature-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Feature Card Base Modifications */
  .feature-card {
    border-radius: 20px;
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  /* Icon Badge Variants */
  .icon-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .icon-variant-1 {
    background-color: #ffdcc8; /* Soft Peach */
    color: var(--color-secondary, #9d4300);
  }

  .icon-variant-2 {
    background-color: #cbe6ff; /* Soft Blue */
    color: var(--color-dark-blue, #082437fc);
  }

  .icon-variant-3 {
    background-color: #e0e0ff; /* Soft Lavender */
    color: #2b2b52;
  }

  .feature-card:hover .icon-wrapper {
    transform: scale(1.1);
  }

  .icon {
    font-size: 30px !important;
  }

  /* Card Typography */
  .card-title {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    color: var(--color-text-dark, #0b1c30);
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 22px;
    color: var(--color-on-primary-container, #7c839b);
  }
</style>