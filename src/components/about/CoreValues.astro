---
import { coreValuesData } from '../../data/about/coreValues';
---

<section class="core-values-section">
  <div class="core-values-container">
    <div class="values-grid">
      {coreValuesData?.map((item) => (
        <div class={`value-card premium-card border-accent-${item.borderAccent}`}>
          
          <!-- Card Header with Icon -->
          <div class="card-header">
            <span class={`material-symbols-outlined icon icon-${item.borderAccent}`}>
              {item.icon}
            </span>
            <h3 class="card-title">{item.title}</h3>
          </div>

          <!-- Card Description -->
          <p class="card-desc">{item.description}</p>

        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Base Layout */
  .core-values-section {
    padding: 60px 24px;
    width: 100%;
    background-color: var(--color-bg, #f8fafc);
  }

  .core-values-container {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  /* Two-Column Grid Layout */
  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Card Layout & Border Accents */
  .value-card {
    padding: 36px 32px;
    border-radius: 16px;
    background-color: var(--color-card-bg, #ffffff);
    border-left: 5px solid transparent;
    display: flex;
    flex-direction: column;
    justify-content: center;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s ease;
  }

  /* Border Accents linked to global variables */
  .border-accent-secondary {
    border-left-color: var(--color-secondary, #9d4300);
  }

  .border-accent-primary {
    border-left-color: var(--color-primary, #000000);
  }

  /* Card Header Alignment */
  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  /* Icon Color Variants */
  .icon {
    font-size: 28px !important;
  }

  .icon-secondary {
    color: var(--color-secondary, #9d4300);
  }

  .icon-primary {
    color: var(--color-primary, #000000);
  }

  /* Typography */
  .card-title {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text-dark, #0b1c30);
    line-height: 1.3;
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 24px;
    color: var(--color-on-primary-container, #7c839b);
  }
</style>