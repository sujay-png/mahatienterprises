---
import { Image } from "astro:assets";
import { certificationsData } from "../../data/about/certifications";
---

<section class="certifications-section">
  <div class="certifications-container">
    <!-- Section Header -->
    <div class="certifications-header">
      <p class="certifications-subtitle">
        {certificationsData?.subtitle}
      </p>

      <h2 class="certifications-title">
        {certificationsData?.title}
      </h2>
    </div>

    <!-- Certification Logos -->
    <div class="certifications-grid">
      {
        certificationsData?.items?.map((item) => (
          <div class="certification-item">
            <div class="logo-wrapper">
              <Image src={item.image} alt={item.alt} loading="lazy" />
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ========================================
     CERTIFICATIONS SECTION
  ======================================== */

  .certifications-section {
    width: 100%;
    background-color: #ffffff;
    padding: 80px 24px 90px;
  }

  .certifications-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
  }

  /* ========================================
     HEADER
  ======================================== */

  .certifications-header {
    text-align: center;
    margin-bottom: 58px;
  }

  .certifications-subtitle {
    font-family: var(--font-heading);
    font-size: 36px;
    line-height: 1.25;
    font-weight: 700;
    color: var(--color-primary, #3d9bd9);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .certifications-title {
    font-family: var(--font-heading);
    font-size: 40px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-secondary, #9d4300);
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* ========================================
     LOGO GRID
  ======================================== */

  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    justify-items: center;
    gap: 50px;
  }

  /* ========================================
     INDIVIDUAL LOGO
  ======================================== */

  .certification-item {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .logo-wrapper {
    width: 100%;
    max-width: 260px;
    height: 170px;

    display: flex;
    justify-content: center;
    align-items: center;

    padding: 15px;
  }

  .logo-wrapper img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 140px;
    height: auto;
    object-fit: contain;

    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.3s ease;
  }

  /* Subtle hover effect */
  .certification-item:hover .logo-wrapper img {
    transform: scale(1.05);
  }

  /* ========================================
     TABLET
  ======================================== */

  @media (max-width: 900px) {
    .certifications-section {
      padding: 70px 24px 80px;
    }

    .certifications-subtitle {
      font-size: 30px;
    }

    .certifications-title {
      font-size: 36px;
    }

    .certifications-grid {
      gap: 30px;
    }

    .logo-wrapper {
      max-width: 220px;
      height: 150px;
    }

    .logo-wrapper img {
      max-height: 120px;
    }
  }

  /* ========================================
     MOBILE
  ======================================== */

  @media (max-width: 767px) {
    .certifications-section {
      padding: 60px 20px 70px;
    }

    .certifications-header {
      margin-bottom: 40px;
    }

    .certifications-subtitle {
      font-size: 25px;
      line-height: 1.3;
    }

    .certifications-title {
      font-size: 32px;
      line-height: 1.2;
    }

    .certifications-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .logo-wrapper {
      max-width: 240px;
      height: 140px;
    }

    .logo-wrapper img {
      max-height: 115px;
    }
  }
</style>
