---
import { faqData } from '../../data/home/faq';
---

<section class="faq-section">
  <div class="faq-container">
    <h2 class="faq-title">{faqData?.title || "Common Questions"}</h2>

    <div class="faq-accordion" data-accordion="single">
      {faqData?.items?.map((item, index) => (
        <div class="faq-item" data-state={index === 0 ? "open" : "closed"}>
          <button type="button" class="faq-trigger" aria-expanded={index === 0 ? "true" : "false"}>
            <span class="faq-question">{index + 1}. {item.question}</span>
            <span class="material-symbols-outlined toggle-icon">expand_more</span>
          </button>

          <div class="faq-content-wrapper" style={index === 0 ? "height: auto;" : "height: 0px;"}>
            <div class="faq-content">
              {item.answerText && <p class="faq-text">{item.answerText}</p>}
              
              {item.answerList && (
                <ul class="faq-list">
                  {item.answerList.map((listItem) => {
                    const [boldPart, ...rest] = listItem.split(':');
                    return (
                      <li>
                        <strong>{boldPart}:</strong>{rest.join(':')}
                      </li>
                    );
                  })}
                </ul>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    // Only select items that haven't been initialized yet
    const accordionItems = document.querySelectorAll('.faq-item:not([data-initialized])');

    accordionItems.forEach((item) => {
      // Mark as initialized
      item.setAttribute('data-initialized', 'true');
      
      const trigger = item.querySelector('.faq-trigger');
      const wrapper = item.querySelector('.faq-content-wrapper') as HTMLElement;

      trigger?.addEventListener('click', () => {
        const isOpen = item.getAttribute('data-state') === 'open';

        // Close all other open items
        document.querySelectorAll('.faq-item').forEach((otherItem) => {
          if (otherItem !== item) {
            otherItem.setAttribute('data-state', 'closed');
            otherItem.querySelector('.faq-trigger')?.setAttribute('aria-expanded', 'false');
            const otherWrapper = otherItem.querySelector('.faq-content-wrapper') as HTMLElement;
            if (otherWrapper) otherWrapper.style.height = '0px';
          }
        });

        // Expand/Collapse active item smoothly
        if (isOpen) {
          item.setAttribute('data-state', 'closed');
          trigger.setAttribute('aria-expanded', 'false');
          wrapper.style.height = '0px';
        } else {
          item.setAttribute('data-state', 'open');
          trigger.setAttribute('aria-expanded', 'true');
          wrapper.style.height = `${wrapper.scrollHeight}px`;
        }
      });
    });
  });
</script>

<style>
  .faq-section {
    background-color: var(--color-bg, #f8fafc);
    padding: 100px 24px;
    width: 100%;
  }

  .faq-container {
    max-width: 800px;
    margin: 0 auto;
    width: 100%;
  }

  .faq-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 32px;
    line-height: 1.2;
    font-weight: 700;
    color: var(--color-text-dark, #0f172a);
    text-align: center;
    margin-bottom: 56px;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .faq-title {
      font-size: 38px;
    }
  }

  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Minimalist Row Item */
  .faq-item {
    background: transparent;
    border-radius: 0;
    border: none;
  }

  /* Trigger Button */
  .faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    background: transparent;
    border: none;
    cursor: pointer;
    text-align: left;
    user-select: none;
  }

  .faq-question {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 18px;
    font-weight: 600;
    color: var(--color-text-dark, #0f172a);
    line-height: 1.4;
  }

  .toggle-icon {
    font-size: 24px !important;
    color: var(--color-text-dark, #0f172a);
    transition: transform 0.3s cubic-bezier(0.87, 0, 0.13, 1);
  }

  .faq-item[data-state="open"] .toggle-icon {
    transform: rotate(180deg);
  }

  /* Smooth Expansion Wrapper */
  .faq-content-wrapper {
    overflow: hidden;
    transition: height 0.35s cubic-bezier(0.87, 0, 0.13, 1);
  }

  .faq-content {
    padding: 12px 0 16px 0;
  }

  .faq-text {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 15px;
    line-height: 26px;
    color: var(--color-text-muted, #475569);
  }

  .faq-list {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 15px;
    line-height: 26px;
    color: var(--color-text-muted, #475569);
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .faq-list li strong {
    color: var(--color-text-dark, #0f172a);
    font-weight: 600;
  }
</style>