---
import { productsData } from '../../data/home/products';
---

<section class="products-section">
  <div class="products-container">
    
    <!-- Header Row -->
    <div class="products-header">
      <div class="header-text font-box">
        <span class="subtitle">{productsData?.subtitle || "ENGINEERED EXCELLENCE"}</span>
        <h2 class="title">{productsData?.title || "Our Product Ecosystem"}</h2>
      </div>
      <a href={productsData?.catalogHref || "/products"} class="catalog-link">
        <span>{productsData?.catalogText || "View Full Catalog"}</span>
        <span class="material-symbols-outlined catalog-arrow">arrow_right_alt</span>
      </a>
    </div>

    <!-- Products Cards Grid -->
    <div class="products-grid">
      {productsData?.items?.map((product) => (
        <div class="product-card">
          
          <!-- Product Image Container -->
          <div class="image-wrapper">
            <img src={product.image} alt={product.alt} class="product-img" />
          </div>

          <!-- Content Area -->
          <div class="card-body">
            <h3 class="product-title">{product.title}</h3>
            <p class="product-desc">{product.description}</p>
            
            <a href={product.href} class="details-btn">
              <span>{product.linkText}</span>
              <span class="material-symbols-outlined btn-arrow">arrow_right_alt</span>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Base Section Background */
  .products-section {
    background-color: var(--color-surface-container-low, #f8fafc);
    padding: 80px 24px 140px 24px;
    width: 100%;
  }

  .products-container {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  /* Header Layout */
  .products-header {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 40px;
  }

  @media (min-width: 768px) {
    .products-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }

  .subtitle {
    display: block;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary-container, #bd621e);
    margin-bottom: 8px;
    
    /* Awwwards micro-reveal effect */
    animation: fadeInSlide 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 32px;
    line-height: 40px;
    font-weight: 700;
    color: var(--color-primary, #0b1727);
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 38px;
      line-height: 46px;
    }
  }

  .catalog-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-primary, #0b1727);
    text-decoration: none;
    transition: color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }

  /* Subtle indicator bar for header link */
  .catalog-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0%;
    height: 2px;
    background-color: var(--color-secondary-container, #bd621e);
    transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    border-radius: 2px;
  }

  .catalog-link:hover::after {
    width: 100%;
  }

  .catalog-link:hover {
    color: var(--color-secondary-container, #bd621e);
  }

  .catalog-arrow {
    font-size: 20px !important;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .catalog-link:hover .catalog-arrow {
    transform: translateX(6px) scale(1.1);
  }

  /* 3-Column Responsive Grid */
  .products-grid {
    display: grid;
    grid-template-columns: 1.2fr;
    gap: 32px;
    perspective: 1200px;
  }

  @media (min-width: 758px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Product Card Styling with Exact Target Height */
  .product-card {
    background: #ffffff;
    border-radius: 20px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 520px;
    height: 100%;
    box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.04), 0px 2px 6px rgba(0, 0, 0, 0.02);
    border: 1px solid rgba(0, 0, 0, 0.03);
    
    transition: 
      transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), 
      box-shadow 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), 
      border-color 0.4s ease;
    will-change: transform, box-shadow;
    position: relative;
  }

  /* High-end ambient highlight border on card lift */
  .product-card::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    padding: 3px;
    background: linear-gradient(135deg, rgba(253, 118, 26, 0.25), transparent 60%);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 10;
  }

  .product-card:hover {
    transform: translateY(-12px) scale(1.015);
    box-shadow: 
      0px 24px 48px -12px rgba(11, 23, 39, 0.12),
      0px 12px 24px -8px rgba(0, 0, 0, 0.04);
    border-color: rgba(253, 118, 26, 0.15);
  }

  .product-card:hover::before {
    opacity: 1;
  }

  /* Image Container */
  .image-wrapper {
    position: relative;
    height: 260px;
    width: 100%;
    padding: 20px;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Radial spotlight background glow on card hover */
  .image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(253, 118, 26, 0.06) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .product-card:hover .image-wrapper::after {
    opacity: 1;
  }

  /* Product Image - Fixed Base Width */
  .product-img {
    width: 100%; /* Changed from 400% to 100% to stay inside wrapper */
    height: 100%;
    object-fit: contain;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
    will-change: transform;
    filter: drop-shadow(0px 8px 16px rgba(0, 0, 0, 0.06));
    z-index: 2;
  }

  /* Smooth, Subtle Zoom-In Effect on Hover */
  .product-card:hover .product-img {
    transform: scale(1.08); /* Reduced from 1.59 to a clean 8% zoom */
    filter: drop-shadow(0px 16px 24px rgba(0, 0, 0, 0.12));
  }

  /* Card Body */
  .card-body {
    padding: 24px 28px 32px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #ffffff;
    z-index: 2;
  }

  .product-title {
    font-family: var(--font-heading, 'Manrope', sans-serif);
    font-size: 18px;
    font-weight: 700;
    color: var(--color-primary, #0b1727);
    margin-bottom: 10px;
    transition: color 0.3s ease;
  }

  .product-card:hover .product-title {
    color: var(--color-secondary-container, #bd621e);
  }

  .product-desc {
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 13.5px;
    line-height: 20px;
    color: #526071;
    flex: 1;
    transition: color 0.3s ease;
  }

  .product-card:hover .product-desc {
    color: #334155;
  }

  /* Details Link Button */
  .details-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-secondary-container, #bd621e);
    text-decoration: none;
    transition: color 0.3s ease;
    width: fit-content;
    margin-top: 24px;
  }

  .btn-arrow {
    font-size: 18px !important;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .details-btn:hover {
    color: var(--color-secondary, #9d4300);
  }

  .details-btn:hover .btn-arrow,
  .product-card:hover .btn-arrow {
    transform: translateX(6px) scale(1.15);
  }

  @keyframes fadeInSlide {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>