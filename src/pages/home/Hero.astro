---
import { Image } from 'astro:assets';
import modiImage from "../../images/mahatimodi.png";
import solarImage from "../../images/mahatisolar.png";
---

<section class="surya-slider">

  <!-- Background glow -->
  <div class="surya-bg-glow"></div>

  <div class="surya-slide">

    <!-- =====================================================
         LEFT: MODI IMAGE
    ====================================================== -->

    <div class="surya-person">

      <div class="person-glow"></div>

      <Image
        src={modiImage}
        alt="PM Surya Ghar Muft Bijli Yojana"
        loading="eager"
        fetchpriority="high"
      />

    </div>


    <!-- =====================================================
         CENTER: MAIN CONTENT
    ====================================================== -->

    <div class="surya-content">

      <!-- Brand -->
      <div class="surya-label">
        MAHATI ENTERPRISES
      </div>


      <!-- Main heading -->
      <h1>
        PM Surya Ghar Muft Bijli Yojana
      </h1>


      <p class="surya-description">
        Government subsidy benefits for residential rooftop solar installations
      </p>


      <!-- =================================================
           BENEFITS
      ================================================== -->

      <div class="benefits-heading">
        Benefits
      </div>


      <div class="residential-label">
        Subsidy for Residential Households
      </div>


      <!-- =================================================
           SUBSIDY STATS
      ================================================== -->

      <div class="subsidy-stats">

        <!-- ₹30,000 -->

        <div class="subsidy-stat">

          <span class="stat-check">
            ✓
          </span>

          <div class="stat-content">

            <strong>
              Rs. 30,000
            </strong>

            <small>
              per kW up to 2 kW
            </small>

          </div>

        </div>


        <!-- ₹18,000 -->

        <div class="subsidy-stat">

          <span class="stat-check">
            ✓
          </span>

          <div class="stat-content">

            <strong>
              Rs. 18,000
            </strong>

            <small>
              per kW for additional capacity up to 3 kW
            </small>

          </div>

        </div>


        <!-- ₹78,000 -->

        <div class="subsidy-stat">

          <span class="stat-check">
            ✓
          </span>

          <div class="stat-content">

            <strong>
              Rs. 78,000
            </strong>

            <small>
              Total subsidy for systems larger than 3 kW (capped)
            </small>

          </div>

        </div>

      </div>


      <!-- =================================================
           GHS / RWA
      ================================================== -->

      <div class="ghs-row">

        <div class="ghs-title">

          <strong>
            Subsidy for GHS/RWA
          </strong>

          <span>
            (Group Housing Society / Resident Welfare Association)
          </span>

        </div>


        <div class="ghs-price">

          <strong>
            Rs. 18,000
          </strong>

          <span>
            per kW
          </span>

        </div>


        <p>
          For common facilities, including EV charging upto 500 KW capacity
          (@3 KW per house), with the upper limit being inclusive of
          individual rooftop plants installed by individual residents in
          the GHS/RWA.
        </p>

      </div>


      <!-- =================================================
           ROOFTOP CAPACITY
      ================================================== -->

      <div class="capacity-section">

        <div class="capacity-title">
          Suitable Rooftop Solar Capacity for Households
        </div>


        <div class="capacity-list">

          <!-- 0-150 -->

          <div class="capacity-item">

            <span>
              Average Monthly Electricity Consumption
            </span>

            <strong>
              0-150
            </strong>

            <small>
              units
            </small>

            <b>
              1-2 kW
            </b>

          </div>


          <!-- 150-300 -->

          <div class="capacity-item">

            <span>
              Average Monthly Electricity Consumption
            </span>

            <strong>
              150-300
            </strong>

            <small>
              units
            </small>

            <b>
              2-3 kW
            </b>

          </div>


          <!-- Above 300 -->

          <div class="capacity-item">

            <span>
              Average Monthly Electricity Consumption
            </span>

            <strong>
              &gt;300
            </strong>

            <small>
              units
            </small>

            <b>
              Above 3kW
            </b>

          </div>

        </div>

      </div>


      <!-- =================================================
           CTA
      ================================================== -->

      <a
        href="/contact"
        class="surya-button"
      >
        Apply for Subsidy

        <span>
          →
        </span>

      </a>

    </div>


    <!-- =====================================================
         RIGHT: SOLAR IMAGE AREA
    ====================================================== -->

    <div class="surya-solar">

      <!-- Solar glow -->

      <div class="solar-glow"></div>


      <!-- Solar image -->

      <Image
        src={solarImage}
        alt="Rooftop Solar Panel"
        loading="eager"
        fetchpriority="high"
      />


      <!-- =================================================
           REGISTERED VENDOR
      ================================================== -->

      <div class="registered-vendor">

        <span>
          REGISTERED
        </span>

        <strong>
          VENDOR
        </strong>

      </div>

    </div>

  </div>

</section>


<style>

/* ============================================================
   FULL WIDTH HERO
============================================================ */

.surya-slider {

  position: relative;

  width: 100%;
  width: 100vw;

  min-height: 590px;

  margin-left: calc(50% - 50vw);

  overflow: hidden;

  background:
    linear-gradient(
      110deg,
      #111d2c 0%,
      #17283b 48%,
      #20354a 100%
    );

  color: #ffffff;

}


/* ============================================================
   BACKGROUND GLOW
============================================================ */

.surya-bg-glow {

  position: absolute;

  width: 600px;

  height: 600px;

  left: 8%;

  top: 5%;

  border-radius: 50%;

  background:
    rgba(253,118,26,.07);

  filter: blur(110px);

  pointer-events: none;

}


/* ============================================================
   MAIN SLIDE
============================================================ */

.surya-slide {

  position: relative;

  width: 100%;

  min-height: 590px;

  padding:
    55px
    6vw
    45px;

  display: grid;

  grid-template-columns:
    230px
    minmax(600px, 1fr)
    420px;

  column-gap: 40px;

  align-items: center;

  box-sizing: border-box;

}


/* ============================================================
   MODI AREA
============================================================ */

.surya-person {

  position: relative;

  height: 490px;

  align-self: end;

  display: flex;

  align-items: flex-end;

  justify-content: center;

  overflow: hidden;

}


.person-glow {

  position: absolute;

  width: 220px;

  height: 220px;

  left: 50%;

  bottom: 40px;

  transform: translateX(-50%);

  border-radius: 50%;

  background:
    rgba(253,118,26,.09);

  filter: blur(65px);

}


.surya-person img {

  position: relative;

  z-index: 2;

  display: block;

  width: 285px;

  max-width: none;

  height: auto;

  align-self: flex-end;

}


/* ============================================================
   CONTENT AREA
============================================================ */

.surya-content {

  position: relative;

  z-index: 10;

  min-width: 0;

  max-width: 800px;

}


.surya-label {

  margin-bottom: 11px;

  color: #fd761a;

  font-family:
    var(
      --font-body,
      'Hanken Grotesk',
      sans-serif
    );

  font-size: 50px;

  line-height: 1;

  font-weight: 700;

  letter-spacing: .16em;

  text-transform: uppercase;

}


.surya-content h1 {

  margin: 0;

  color: #ffffff;

  font-family:
    var(
      --font-heading,
      'Manrope',
      sans-serif
    );

  font-size:
    clamp(32px, 3.2vw, 28px);

  line-height: 1.08;

  font-weight: 700;

  letter-spacing: -.035em;

}


.surya-description {

  max-width: 620px;

  margin:
    12px
    0
    25px;

  color:
    rgba(255,255,255,.60);

  font-family:
    var(
      --font-body,
      'Hanken Grotesk',
      sans-serif
    );

  font-size: 14px;

  line-height: 1.6;

}


/* ============================================================
   BENEFITS
============================================================ */

.benefits-heading {

  margin-bottom: 9px;

  color: #ffffff;

  font-family:
    var(
      --font-heading,
      'Manrope',
      sans-serif
    );

  font-size: 20px;

  line-height: 1.2;

  font-weight: 700;

}


.residential-label {

  margin-bottom: 9px;

  color:
    rgba(255,255,255,.70);

  font-family:
    var(
      --font-body,
      'Hanken Grotesk',
      sans-serif
    );

  font-size: 12px;

  font-weight: 600;

}


/* ============================================================
   SUBSIDY STATS
============================================================ */

.subsidy-stats {

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0,1fr));

  gap: 10px;

}


.subsidy-stat {

  min-height: 78px;

  display: flex;

  align-items: flex-start;

  gap: 9px;

  padding: 13px;

  border-radius: 12px;

  background:
    rgba(255,255,255,.055);

  border:
    1px solid rgba(255,255,255,.08);

  transition:
    background .25s ease,
    border-color .25s ease,
    transform .25s ease;

}


.subsidy-stat:hover {

  transform:
    translateY(-2px);

  background:
    rgba(255,255,255,.08);

  border-color:
    rgba(253,118,26,.35);

}


.stat-check {

  flex-shrink: 0;

  width: 16px;

  height: 16px;

  display: flex;

  justify-content: center;

  align-items: center;

  margin-top: 1px;

  border-radius: 4px;

  background: #4bd890;

  color: #ffffff;

  font-size: 9px;

  line-height: 1;

  font-weight: 800;

}


.stat-content {

  min-width: 0;

}


.subsidy-stat strong {

  display: block;

  color: #ffffff;

  font-family:
    var(
      --font-heading,
      'Manrope',
      sans-serif
    );

  font-size: 16px;

  line-height: 1.2;

  font-weight: 700;

}


.subsidy-stat small {

  display: block;

  margin-top: 5px;

  color:
    rgba(255,255,255,.53);

  font-family:
    var(
      --font-body,
      'Hanken Grotesk',
      sans-serif
    );

  font-size: 10px;

  line-height: 1.4;

}


/* ============================================================
   GHS / RWA
============================================================ */

.ghs-row {

  display: grid;

  grid-template-columns:
    1.1fr
    145px
    1.5fr;

  gap: 18px;

  align-items: center;

  margin-top: 11px;

  padding:
    13px
    15px;

  border-radius: 12px;

  background:
    rgba(255,255,255,.035);

  border:
    1px solid rgba(255,255,255,.07);

}


.ghs-title strong {

  display: block;

  color:
    rgba(255,255,255,.88);

  font-family:
    var(
      --font-heading,
      'Manrope',
      sans-serif
    );

  font-size: 12px;

  line-height: 1.2;

}


.ghs-title span {

  display: block;

  margin-top: 4px;

  color:
    rgba(255,255,255,.40);

  font-size: 8px;

  line-height: 1.35;

}


.ghs-price strong {

  display: block;

  color: #fd761a;

  font-family:
    var(
      --font-heading,
      'Manrope',
      sans-serif
    );

  font-size: 20px;

  line-height: 1;

}


.ghs-price span {

  display: block;

  margin-top: 3px;

  color:
    rgba(255,255,255,.45);

  font-size: 9px;

}


.ghs-row p {

  margin: 0;

  color:
    rgba(255,255,255,.48);

  font-size: 8px;

  line-height: 1.5;

}


/* ============================================================
   ROOFTOP CAPACITY
============================================================ */

.capacity-section {

  margin-top: 15px;

}


.capacity-title {

  margin-bottom: 8px;

  color:
    rgba(255,255,255,.78);

  font-family:
    var(
      --font-body,
      'Hanken Grotesk',
      sans-serif
    );

  font-size: 12px;

  line-height: 1.3;

  font-weight: 600;

}


.capacity-list {

  display: grid;

  grid-template-columns:
    repeat(3,1fr);

  gap: 8px;

}


.capacity-item {

  padding:
    9px
    11px;

  border-radius: 10px;

  background:
    rgba(255,255,255,.045);

  border:
    1px solid rgba(255,255,255,.06);

}


.capacity-item span {

  display: block;

  color:
    rgba(255,255,255,.40);

  font-size: 8px;

  line-height: 1.25;

}


.capacity-item strong {

  display: inline-block;

  margin-top: 4px;

  color: #ffffff;

  font-family:
    var(
      --font-heading,
      'Manrope',
      sans-serif
    );

  font-size: 14px;

  line-height: 1;

}


.capacity-item small {

  margin-left: 3px;

  color:
    rgba(255,255,255,.40);

  font-size: 8px;

}


.capacity-item b {

  display: block;

  margin-top: 4px;

  color: #fd761a;

  font-size: 10px;

  font-weight: 700;

}


/* ============================================================
   CTA
============================================================ */

.surya-button {

  display: inline-flex;

  align-items: center;

  gap: 11px;

  margin-top: 17px;

  padding:
    12px
    20px;

  border-radius: 12px;

  background: #fd761a;

  color: #ffffff;

  font-family:
    var(
      --font-body,
      'Hanken Grotesk',
      sans-serif
    );

  font-size: 12px;

  line-height: 1;

  font-weight: 700;

  text-decoration: none;

  box-shadow:
    0 8px 20px
    rgba(253,118,26,.20);

  transition:
    transform .25s ease,
    background .25s ease,
    box-shadow .25s ease;

}


.surya-button span {

  font-size: 16px;

  line-height: 1;

  transition:
    transform .25s ease;

}


.surya-button:hover {

  transform:
    translateY(-2px);

  background:
    #ff842d;

  box-shadow:
    0 10px 25px
    rgba(253,118,26,.32);

}


.surya-button:hover span {

  transform:
    translateX(3px);

}


/* ============================================================
   SOLAR AREA
============================================================ */

.surya-solar {

  position: relative;

  z-index: 4;

  height: 490px;

  display: flex;

  align-items: flex-end;

  justify-content: center;

  overflow: visible;

}


/* Solar glow */

.solar-glow {

  position: absolute;

  width: 300px;

  height: 300px;

  right: 15px;

  bottom: 70px;

  border-radius: 50%;

  background:
    rgba(255,255,255,.055);

  filter: blur(75px);

}


/* Solar image */

.surya-solar img {

  position: relative;

  z-index: 3;

  display: block;

  width: 440px;

  max-width: none;

  height: auto;

  transform:
    translateY(5px);

  filter:
    drop-shadow(
      0 15px 25px
      rgba(0,0,0,.20)
    );

}


/* ============================================================
   REGISTERED VENDOR
============================================================ */

.registered-vendor {

  position: absolute;

  z-index: 10;

  left: 12px;

  bottom: 12px;

  width: 82px;

  height: 82px;

  display: flex;

  flex-direction: column;

  justify-content: center;

  align-items: center;

  border-radius: 50%;

  background: #ffffff;

  border:
    4px solid #fd761a;

  color: #172033;

  font-family:
    var(
      --font-body,
      'Hanken Grotesk',
      sans-serif
    );

  font-size: 8px;

  line-height: 1.25;

  font-weight: 700;

  text-align: center;

  box-shadow:
    0 8px 20px
    rgba(0,0,0,.18);

  transition:
    transform .3s ease,
    box-shadow .3s ease;

}


.registered-vendor strong {

  display: block;

  font-size: 9px;

}


.registered-vendor:hover {

  transform:
    translateY(-3px);

  box-shadow:
    0 12px 25px
    rgba(0,0,0,.25);

}


/* ============================================================
   LARGE DESKTOP
   ORIGINAL DESKTOP DESIGN
============================================================ */

@media (min-width: 1500px) {

  .surya-slide {

    padding-left: 8vw;

    padding-right: 7vw;

    grid-template-columns:
      250px
      minmax(700px,1fr)
      500px;

    column-gap: 45px;

  }


  .surya-person img {

    width: 310px;

  }


  .surya-solar img {

    width: 500px;

  }


  .registered-vendor {

    left: 20px;

    bottom: 12px;

  }

}


/* ============================================================
   TABLET / SMALL DESKTOP
============================================================ */

@media (max-width: 1150px) and (min-width: 769px) {

  .surya-slide {

    grid-template-columns:
      170px
      minmax(0,1fr)
      300px;

    padding:
      45px
      4vw
      40px;

    column-gap: 25px;

  }


  .surya-person {

    height: 450px;

  }


  .surya-person img {

    width: 225px;

  }


  .surya-solar {

    height: 450px;

  }


  .surya-solar img {

    width: 330px;

  }


  .registered-vendor {

    width: 75px;

    height: 75px;

    left: 5px;

    bottom: 12px;

  }


  .subsidy-stats {

    grid-template-columns:
      1fr;

  }


  .subsidy-stat {

    min-height: 60px;

  }


  .ghs-row {

    grid-template-columns:
      1fr
      120px;

    gap: 12px;

  }


  .ghs-row p {

    grid-column:
      1 / -1;

  }

}


/* ============================================================
   ============================================================
   MOBILE ONLY
   ============================================================
============================================================ */

@media (max-width: 768px) {

  /* ----------------------------------------------------------
     HERO
  ---------------------------------------------------------- */

  .surya-slider {

    width: 100vw;

    min-height: 0;

    height: auto;

    margin-left:
      calc(50% - 50vw);

    overflow: hidden;

    background:
      linear-gradient(
        145deg,
        #111d2c 0%,
        #17283b 100%
      );

  }


  /* ----------------------------------------------------------
     MAIN CONTAINER
  ---------------------------------------------------------- */

  .surya-slide {

    width: 100%;

    min-height: 0;

    padding:
      28px
      16px
      0;

    display: flex;

    flex-direction: column;

    box-sizing: border-box;

  }


  /* ----------------------------------------------------------
     CONTENT
  ---------------------------------------------------------- */

  .surya-content {

    order: 1;

    width: 100%;

    max-width: none;

    min-width: 0;

    position: relative;

    z-index: 20;

  }


  /* ----------------------------------------------------------
     BRAND
  ---------------------------------------------------------- */

  .surya-label {

    display: inline-block;

    margin:
      0
      0
      8px;

    color: #fd761a;

    font-size: 9px;

    line-height: 1;

    font-weight: 700;

    letter-spacing: .14em;

  }


  /* ----------------------------------------------------------
     TITLE
  ---------------------------------------------------------- */

  .surya-content h1 {

    display: block;

    margin: 0;

    max-width: 340px;

    color: #ffffff;

    font-size: 26px;

    line-height: 1.12;

    letter-spacing: -.035em;

  }


  /* ----------------------------------------------------------
     DESCRIPTION
  ---------------------------------------------------------- */

  .surya-description {

    display: block;

    max-width: 320px;

    margin:
      9px
      0
      22px;

    color:
      rgba(255,255,255,.55);

    font-size: 10px;

    line-height: 1.5;

  }


  /* ----------------------------------------------------------
     BENEFITS
  ---------------------------------------------------------- */

  .benefits-heading {

    margin:
      0
      0
      6px;

    color: #ffffff;

    font-size: 17px;

    line-height: 1.2;

    font-weight: 700;

  }


  .residential-label {

    margin:
      0
      0
      9px;

    color:
      rgba(255,255,255,.62);

    font-size: 9px;

    line-height: 1.3;

    font-weight: 500;

  }


  /* ----------------------------------------------------------
     SUBSIDY CARDS
  ---------------------------------------------------------- */

  .subsidy-stats {

    display: grid;

    grid-template-columns:
      repeat(3, minmax(0,1fr));

    gap: 7px;

    width: 100%;

  }


  .subsidy-stat {

    min-width: 0;

    min-height: 70px;

    display: block;

    padding:
      11px
      9px;

    border-radius: 10px;

    background:
      rgba(255,255,255,.055);

    border:
      1px solid
      rgba(255,255,255,.075);

    box-sizing: border-box;

  }


  .subsidy-stat:hover {

    transform: none;

    background:
      rgba(255,255,255,.055);

    border-color:
      rgba(255,255,255,.075);

  }


  /* Hide checks only on mobile */

  .stat-check {

    display: none;

  }


  .stat-content {

    display: block;

    min-width: 0;

  }


  .subsidy-stat strong {

    display: block;

    color: #ffffff;

    font-size: 12px;

    line-height: 1.15;

    white-space: nowrap;

  }


  .subsidy-stat small {

    display: block;

    margin-top: 5px;

    color:
      rgba(255,255,255,.48);

    font-size: 7px;

    line-height: 1.35;

  }


  .subsidy-stat:first-child {

    border-top:
      2px solid #fd761a;

  }


  /* ----------------------------------------------------------
     GHS / RWA
  ---------------------------------------------------------- */

  .ghs-row {

    width: 100%;

    margin-top: 9px;

    padding: 12px;

    display: grid;

    grid-template-columns:
      1fr
      auto;

    gap: 8px;

    align-items: center;

    box-sizing: border-box;

    border-radius: 10px;

    background:
      rgba(255,255,255,.035);

    border:
      1px solid
      rgba(255,255,255,.065);

  }


  .ghs-title {

    min-width: 0;

  }


  .ghs-title strong {

    display: block;

    color:
      rgba(255,255,255,.88);

    font-size: 9px;

    line-height: 1.2;

  }


  .ghs-title span {

    display: block;

    margin-top: 3px;

    color:
      rgba(255,255,255,.35);

    font-size: 6px;

    line-height: 1.3;

  }


  .ghs-price {

    text-align: right;

    white-space: nowrap;

  }


  .ghs-price strong {

    display: block;

    color: #fd761a;

