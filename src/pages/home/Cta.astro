---
import { ctaData } from '../../data/home/cta';
---

<section class="cta-section">
  <div class="cta-container">
    <div class="cta-card">
      
      <!-- Headline & Subtitle -->
      <h2 class="cta-title">{ctaData?.title || "Ready to lower your energy bills?"}</h2>
      <p class="cta-desc">
        {ctaData?.description || "Start your journey towards energy independence with Mahati Enterprises. Get a free site assessment today."}
      </p>

      <!-- Action Buttons -->
      <div class="cta-actions">
        <a href={ctaData?.primaryButtonHref || "/contact"} class="btn-dark">
          {ctaData?.primaryButtonText || "Switch to Solar Today!"}
        </a>
        <a href={ctaData?.phoneNumberHref || "tel:+919154455333"} class="btn-white">
          {ctaData?.phoneNumberText || "Call +91 91544 55333"}
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  /* Light outer background section */
  .cta-section {
    background-color: #f3f6fa;
    padding: 60px 24px;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .cta-container {
    max-width: 1100px;
    width: 100%;
  }

  /* Main Orange Card */
  .cta-card {
    background-color: #ff6912;
    border-radius: 28px;
    padding: 56px 32px;
    text-align: center;
    color: #ffffff;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0px 16px 36px rgba(0, 0, 0, 0.06);
  }

  /* Title Heading */
  .cta-title {
    font-family: var(--font-heading, 'Manrope', -apple-system, sans-serif);
    font-size: 38px;
    line-height: 46px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 16px;
    letter-spacing: -0.01em;
  }

  /* Description Paragraph */
  .cta-desc {
    font-family: var(--font-body, 'Hanken Grotesk', -apple-system, sans-serif);
    font-size: 14px;
    line-height: 22px;
    color: rgba(255, 255, 255, 0.95);
    max-width: 540px;
    margin-bottom: 36px;
    font-weight: 400;
  }

  /* Buttons Container */
  .cta-actions {
    display: flex;
    flex-direction: flex-row;
    gap: 16px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    width: 100%;
  }

  /* Left Button - Black with White Text */
  .btn-dark {
    background-color: #0e1117;
    color: #ffffff !important;
    height: 48px;
    padding: 0 28px;
    border-radius: 10px;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.15);
  }

  .btn-dark:hover {
    background-color: #1a1e26;
    transform: translateY(-2px);
    box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.25);
  }

  /* Right Button - White with Orange Text */
  .btn-white {
    background-color: #ffffff;
    color: #c85000 !important;
    height: 48px;
    padding: 0 28px;
    border-radius: 10px;
    font-family: var(--font-body, 'Hanken Grotesk', sans-serif);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.05);
  }

  .btn-white:hover {
    background-color: #f8fafc;
    transform: translateY(-2px);
    box-shadow: 0px 6px 16px rgba(0, 0, 0, 0.1);
  }

  .btn-dark:active,
  .btn-white:active {
    transform: translateY(0);
  }
</style>