---
import { getImage } from 'astro:assets';
import solarImage from '../images/mahatisolar.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../pages/home/Hero.astro';
import Certifications from '../components/about/certifications.astro';
import SubsidyBanner from '../pages/home/SubsidyBanner.astro';
import ClientLogos from '../components/clients/ClientLogos.astro';
import MissionStats from '../pages/home/MissionStats.astro';
import Products from '../pages/home/Products.astro';
import Services from '../pages/home/Services.astro';
import OurWorkGrid from '../components/our-work/OurWorkGrid.astro';
import Testimonials from '../pages/home/Testimonials.astro';
import WhyChooseClients from '../components/clients/WhyChooseClients.astro';
import Faq from '../pages/home/Faq.astro';
import Cta from '../pages/home/Cta.astro';
import LatestBlogs from '../pages/home/LatestBlogs.astro';

const preloadedSolar = await getImage({
  src: solarImage,
  width: 500,
  widths: [250, 375, 500, 750, 900],
});
---

<BaseLayout title="Solar Suppliers: Reliable Power Solutions | Mahati Enterprises" description="Explore high-quality solar for home, automotive, and industrial use. We offer reliable, long-lasting solar power solutions you can trust">
  <link
    slot="head"
    rel="preload"
    as="image"
    href={preloadedSolar.src}
    imagesrcset={preloadedSolar.srcSet.attribute}
    imagesizes="(max-width: 480px) 250px, (max-width: 768px) 270px, (max-width: 1150px) 330px, (max-width: 1350px) 440px, 500px"
    fetchpriority="high"
  />
  <Hero />
  <Certifications />
  <SubsidyBanner />
  <ClientLogos />
  <MissionStats />
  <Products />
  <Services />
  <OurWorkGrid limit={3} showViewAll={true} />
  <Testimonials />
  <WhyChooseClients />
  <LatestBlogs />
  <Faq />
  <Cta />
</BaseLayout>
