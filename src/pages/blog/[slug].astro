    '/blog/the-science-behind-solar-panel-efficiency-improvements-in-2026': '/blog/solar-panel-efficiency-guide',
    '/ups-systems-online-vs-offline-ups-which-one-does-your-business-actually-need': '/blog/online-vs-offline-ups',
    '/blog/ups-systems-online-vs-offline-ups-which-one-does-your-business-actually-need': '/blog/online-vs-offline-ups',
    '/why-hybrid-solar-systems-offer-the-best-value-for-homeowners': '/blog/hybrid-solar-systems-worth',
    '/blog/why-hybrid-solar-systems-offer-the-best-value-for-homeowners': '/blog/hybrid-solar-systems-worth',
    '/blog/on-grid-vs-off-grid-systems': '/blog/on-grid-vs-off-grid-solar-systems',
    '/hybrid-solar-systems': '/solar-products',
    '/off-grid-solar-systems': '/solar-products',
    '/solar-panel-maintenance-repairs': '/services',
    '/tips-for-maintaining-efficiency-of-solar-panels-in-coastal-areas': '/blog/solar-panel-efficiency',
    '/blog/tips-for-maintaining-efficiency-of-solar-panels-in-coastal-areas': '/blog/solar-panel-efficiency',
    '/how-to-get-the-most-out-of-your-solar-panel-investment': '/blog/solar-panel-investment',
    '/blog/how-to-get-the-most-out-of-your-solar-panel-investment': '/blog/solar-panel-investment',
    '/how-solar-inverter-batteries-can-reduce-your-electricity-bills': '/blog/solar-inverter-batteries',
    '/blog/how-solar-inverter-batteries-can-reduce-your-electricity-bills': '/blog/solar-inverter-batteries',
    '/affordable-solar-solutions-for-small-businesses-in-2026': '/blog/affordable-solar-solutions',
    '/blog/affordable-solar-solutions-for-small-businesses-in-2026': '/blog/affordable-solar-solutions',
    '/recent-innovations-in-solar-technology-and-energy-storage': '/blog/solar-technology-and-storage',
    '/blog/recent-innovations-in-solar-technology-and-energy-storage': '/blog/solar-technology-and-storage',
    '/5-common-solar-power-mistakes-and-how-to-avoid-them': '/blog/solar-power-mistakes-to-avoid',
    '/blog/5-common-solar-power-mistakes-and-how-to-avoid-them': '/blog/solar-power-mistakes-to-avoid',
    '/top-features-to-look-for-in-residential-solar-inverter-batteries': '/blog/home-solar-inverter-batteries',
    '/blog/top-features-to-look-for-in-residential-solar-inverter-batteries': '/blog/home-solar-inverter-batteries',
    '/advantages-of-choosing-lithium-ion-batteries-for-solar-storage': '/blog/batteries-solar-storage',
    '/blog/advantages-of-choosing-lithium-ion-batteries-for-solar-storage': '/blog/batteries-solar-storage',
    '/why-your-business-needs-a-reliable-ups-with-solar-backup': '/blog/reliable-ups-solar-backup',
    '/blog/why-your-business-needs-a-reliable-ups-with-solar-backup': '/blog/reliable-ups-solar-backup',
    '/indias-most-popular-places-that-have-embraced-green-energy': '/blog/green-energy-places-in-india',
    '/blog/indias-most-popular-places-that-have-embraced-green-energy': '/blog/green-energy-places-in-india',
  };

  sanitized = sanitized.replace(/<a\b([^>]*)>/gi, (match, attrs) => {
    const hrefMatch = attrs.match(/href=(["'])(.*?)\1/i);
    if (!hrefMatch) return match;

    const rawHref = hrefMatch[2].trim();
    const isMahati = /^https?:\/\/(www\.|dashboard\.)?mahatienterprises\.com(\/|$)/i.test(rawHref);
    const isRelative = rawHref.startsWith('/') || rawHref.startsWith('./') || rawHref.startsWith('../');

    if (!isMahati && !isRelative) {
      return match;
    }

    // Preserve WordPress media uploads / admin
    if (/^https?:\/\/dashboard\.mahatienterprises\.com\/wp-(content|admin|includes)/i.test(rawHref)) {
      return match;
    }

    let pathname = '';
    let hash = '';
    let search = '';

    try {
      const u = isMahati ? new URL(rawHref) : new URL(rawHref, 'https://www.mahatienterprises.com');
      pathname = u.pathname;
      hash = u.hash;
      search = u.search;
    } catch {
      return match;
    }

    // Strip trailing slashes except for root '/'
    if (pathname.length > 1 && pathname.endsWith('/')) {
      pathname = pathname.slice(0, -1);
    }

    // Resolve old redirected URLs to their direct canonical destination
    const lowerPath = pathname.toLowerCase();
    if (linkRedirectMap[lowerPath]) {
      pathname = linkRedirectMap[lowerPath];
    }

    const canonicalHref = `${pathname}${search}${hash}`;
    let updatedAttrs = attrs.replace(/href=(["'])(.*?)\1/i, `href="${canonicalHref}"`);

    // Strip 'nofollow' from internal links
    if (/rel=["'][^"']*nofollow[^"']*["']/i.test(updatedAttrs)) {
      updatedAttrs = updatedAttrs.replace(/\s*\brel=(["'])(.*?)\1/i, (_relMatch, quote, relVal) => {
        const tokens = relVal.split(/\s+/).filter((t: string) => t.toLowerCase() !== 'nofollow' && t.trim() !== '');
        if (tokens.length === 0) {
          return '';
        }
        return ` rel=${quote}${tokens.join(' ')}${quote}`;
      });
    }

    return `<a${updatedAttrs}>`;
  });

  // 3. Ensure all embedded post images have descriptive, keyword-rich alt text
  sanitized = sanitized.replace(/<img\b([^>]*)>/gi, (match, attrs) => {
    const altMatch = attrs.match(/\balt=(["'])(.*?)\1/i);
    const hasAlt = altMatch && altMatch[2].trim().length > 0;

    if (!hasAlt) {
      let altText = '';
      if (/Solar-panel-payback-roi/i.test(attrs)) {
        altText = 'Solar panel payback period and ROI calculation guide for rooftop solar systems';
      } else if (/Solar_panel_inverter_UPS_mainten/i.test(attrs)) {
        altText = 'Solar panel, inverter, and UPS maintenance and longevity guide';
      } else if (postTitle) {
        altText = `${postTitle} - Mahati Enterprises`;
      } else {
        altText = 'Mahati Enterprises Solar and Energy Solutions';
      }

      if (altMatch) {
        const updatedAttrs = attrs.replace(/\balt=(["'])(.*?)\1/i, `alt="${altText}"`);
        return `<img${updatedAttrs}>`;
      } else {
        return `<img alt="${altText}"${attrs}>`;
      }
    }

    return match;
  });

  // 4. Shorten H2 headings over 70 characters (and synchronize matching TOC anchors)
  sanitized = sanitized.replace(
    /Why Incorrect Cleaning Damages Photovoltaic Modules and Voids Warranties/g,
    'Why Incorrect Cleaning Damages Solar Panels & Voids Warranties'
  );
  sanitized = sanitized.replace(
    /Why Solar Inverter Batteries Are a Game Changer for Your Electricity Bills/g,
    'Why Solar Inverter Batteries Cut Your Electricity Bills'
  );

  // 5. Ensure sequential heading hierarchy for Table of Contents (convert <h3>TABLE OF CONTENT</h3> to <h2>)
  sanitized = sanitized.replace(/<h3(\b[^>]*)>\s*(TABLE OF CONTENT[S]?)\s*<\/h3>/gi, '<h2$1>$2</h2>');

  // 6. Fix accidental Google search query links created during WordPress drafting
  sanitized = sanitized.replace(/href=(["'])https:\/\/www\.google\.com\/search\?q=([^"']+)\1/gi, (match, quote, query) => {
    let target = decodeURIComponent(query).trim();
    if (target.startsWith('/')) {
      if (target === '/') return 'href="/"';
      if (target.endsWith('/')) target = target.slice(0, -1);
      if (linkRedirectMap[target.toLowerCase()]) {
        target = linkRedirectMap[target.toLowerCase()];
      }
      return `href="${target}"`;
    }
    return match;
  });

  // 7. Percent-encode non-ASCII ellipsis in media URLs to prevent "URL: Non ASCII Characters"
  sanitized = sanitized.replace(/(src|href|srcset)=(["'])([\s\S]*?)\2/gi, (match, attr, quote, val) => {
    if (val.includes('…')) {
      return `${attr}=${quote}${val.replace(/…/g, '%E2%80%A6')}${quote}`;
    }
    return match;
  });

  return sanitized;
}

const cleanContent = sanitizePostContent(post.content || '', post.title || '');
---


<BaseLayout seo={blogSeo}>


  <!-- =====================================
       ARTICLE HERO
  ====================================== -->

  <section class="article-hero">

    <div class="article-container">

      <!-- Breadcrumb -->

      <div class="breadcrumb">

        <a href="/">
          Home
        </a>

        <span>↓</span>

    

    
 
    
      </div>


      <!-- Category -->

      <div class="article-category">
        {category}
      </div>


      <!-- Title -->

      <h1>
        {post.title}
      </h1>


      <!-- Meta -->

      <div class="article-meta">

        <span>
          {formattedDate}
        </span>

        <span class="meta-dot"></span>

    

      </div>

    </div>

  </section>



  <!-- =====================================
       FEATURED IMAGE
  ====================================== -->

  {
    post.featuredImage?.node?.sourceUrl && (

      <section class="featured-section">

        <div class="featured-container">

          <img
            src={post.featuredImage.node.sourceUrl}
            alt={
              post.featuredImage.node.altText ||
              post.title
            }
            class="featured-image"
          />

        </div>

      </section>

    )
  }



  <!-- =====================================
       ARTICLE CONTENT
  ====================================== -->

  <section class="article-section">

    <div class="article-layout">


      <!-- Main Article -->

      <article class="article-content">

        <div
          class="wordpress-content"
          set:html={cleanContent}
        ></div>


        <!-- Back to Blog -->

        <div class="article-bottom">

          <a
            href="/blog"
            class="back-to-blog"
          >

            <span class="back-arrow">
              ←
            </span>

            <span>
              Back to all articles
            </span>

          </a>

        </div>

      </article>


      <!-- Sidebar -->

      <aside class="article-sidebar">

        <div class="sidebar-card">

          <span class="sidebar-label">
            MAHATI ENTERPRISES
          </span>

          <h3>
            Powering a
            <em>Brighter</em>
            Future
          </h3>

          <p>
            Discover our solar, UPS, battery and
            sustainable energy solutions.
          </p>

          <a
            href="/contact"
            class="sidebar-button"
          >
            Talk to Our Experts
            <span>→</span>
          </a>

        </div>

      </aside>


    </div>

  </section>


</BaseLayout>



<style>


/* =========================================
   ARTICLE HERO
========================================= */

.article-hero {

  padding:
    80px 24px
    70px;

  background:
    radial-gradient(
      circle at 85% 20%,
      rgba(126, 158, 78, 0.12),
      transparent 35%
    ),
    #f7f8f5;
}


.article-container {

  width:
    min(1000px, 100%);

  margin:
    0 auto;

  text-align:
    center;
}


/* =========================================
   BREADCRUMB
========================================= */

.breadcrumb {

  display:
    flex;

  justify-content:
    center;

  align-items:
    center;

  flex-wrap:
    wrap;

  gap:
    9px;

  margin-bottom:
    30px;

  color:
    #8a9388;

  font-size:
    12px;
}


.breadcrumb a {

  color:
    #65725f;

  text-decoration:
    none;

  transition:
    color .2s ease;
}


.breadcrumb a:hover {

  color:
    #78954d;
}


.breadcrumb span:nth-child(2),
.breadcrumb span:nth-child(4) {

  color:
    #b6bdb3;
}


/* =========================================
   CATEGORY
========================================= */

.article-category {

  display:
    inline-flex;

  align-items:
    center;

  padding:
    8px 15px;

  border:
    1px solid
    rgba(120, 149, 77, .25);

  border-radius:
    100px;

  background:
    rgba(120, 149, 77, .08);

  color:
    #78954d;

  font-size:
    11px;

  font-weight:
    700;

  letter-spacing:
    1.8px;

  text-transform:
    uppercase;
}


/* =========================================
   TITLE
========================================= */

.article-hero h1 {

  max-width:
    950px;

  margin:
    25px auto 0;

  color:
    #172018;

  font-size:
    clamp(
      38px,
      5vw,
      68px
    );

  font-weight:
    600;

  line-height:
    1.05;

  letter-spacing:
    -2px;
}


/* =========================================
   META
========================================= */

.article-meta {

  display:
    flex;

  justify-content:
    center;

  align-items:
    center;

  gap:
    12px;

  margin-top:
    28px;

  color:
    #697269;

  font-size:
    13px;
}


.meta-dot {

  width:
    4px;

  height:
    4px;

  border-radius:
    50%;

  background:
    #9cac91;
}


/* =========================================
   FEATURED IMAGE
========================================= */

.featured-section {

  padding:
    0 24px;

  background:
    #f7f8f5;
}


.featured-container {

  width:
    min(1180px, 100%);

  margin:
    0 auto;

  transform:
    translateY(25px);
}


.featured-image {

  display:
    block;

  width:
    100%;

  max-height:
    620px;

  object-fit:
    cover;

  border-radius:
    26px;

  box-shadow:
    0 30px 80px
    rgba(20, 30, 20, .14);
}


/* =========================================
   ARTICLE SECTION
========================================= */

.article-section {

  padding:
    100px 24px
    120px;

  background:
    #ffffff;
}


.article-layout {

  display:
    grid;

  grid-template-columns:
    minmax(0, 1fr)
    300px;

  gap:
    70px;

  width:
    min(1080px, 100%);

  margin:
    0 auto;

  align-items:
    start;
}


/* =========================================
   ARTICLE CONTENT
========================================= */

.article-content {

  min-width:
    0;
}


.wordpress-content {

  color:
    #000000;

  font-size:
    20px;

  line-height:
    1.85;
}


/* Paragraph */

.wordpress-content :global(p) {

  margin:
    0 0 24px;
}


/* Headings */

.wordpress-content :global(h2) {

  margin:
    50px 0 20px;

  color:
    #172018;

  font-size:
    34px;

  line-height:
    1.2;

  letter-spacing:
    -.7px;
}


.wordpress-content :global(h3) {

  margin:
    40px 0 16px;

  color:
    #172018;

  font-size:
    26px;

  line-height:
    1.3;
}


.wordpress-content :global(h4) {

  margin:
    32px 0 14px;

  color:
