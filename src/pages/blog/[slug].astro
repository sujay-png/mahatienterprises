import BaseLayout from '../../layouts/BaseLayout.astro';
import { fetchWordPress, fetchAllWordPressPosts } from '../../data/wordpress';
import { getBlogPostSeo } from '../../seo/seo';

export async function getStaticPaths() {
  const posts = await fetchAllWordPressPosts<{ slug: string }>('slug');

  return posts.map((post: any) => ({
    params: {
      slug: post.slug,
    },
  }));
}


const { slug } = Astro.params;


const query = `
  query GetSinglePost($slug: ID!) {
    post(id: $slug, idType: SLUG) {
      id
      title
      slug
      date
      content
      excerpt

      featuredImage {
        node {
          sourceUrl
          altText
        }
      }

      categories {
        nodes {
          name
          slug
        }
      }

      author {
        node {
          name
        }
      }

      seo {
        title
        description
        focusKeywords
        canonicalUrl
      }
    }
  }
`;


const data = await fetchWordPress(query, {
  slug,
});


const post = data.post;


if (!post) {
  throw new Error('Blog post not found');
}


const category =
  post.categories?.nodes?.[0]?.name || 'Insights';


const author =
  post.author?.node?.name || 'Mahati Enterprises';


const formattedDate =
  new Date(post.date).toLocaleDateString(
    'en-IN',
    {
      day: '2-digit',
      month: 'long',
      year: 'numeric',
    }
  );
const blogSeo = getBlogPostSeo(post, Astro.url.href);

function sanitizePostContent(html: string, postTitle: string = ''): string {
  if (!html) return '';

  // 1. Fix deprecated AJAX crawling scheme hashbang link (#! -> #1)
  let sanitized = html.replace(/href=["']#!["']/g, 'href="#1"');

  // 2. Normalize internal links (resolve redirects, strip trailing slashes, remove non-www/dashboard prefixes) & strip 'nofollow'
  const linkRedirectMap: Record<string, string> = {
