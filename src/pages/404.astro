---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found">
  <div style="text-align: center; padding: 100px 20px;">
    <h1 style="font-size: 48px; margin-bottom: 20px;">404 - Page Not Found</h1>
    <p style="font-size: 20px; color: #555;">Sorry, we couldn't find the page you're looking for.</p>
    <a href="/" style="display: inline-block; margin-top: 30px; padding: 12px 24px; background: #78954d; color: #fff; text-decoration: none; border-radius: 8px;">Return to Homepage</a>
  </div>
</BaseLayout>
